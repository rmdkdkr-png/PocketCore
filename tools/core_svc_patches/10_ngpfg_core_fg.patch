diff -ruN pa/build/ngpfg.c pb/build/ngpfg.c
--- a/build/ngpfg.c	1970-01-01 09:00:00.000000000 +0900
+++ b/build/ngpfg.c	2026-10-16 18:10:50.018676149 +0900
@@ -0,0 +1,533 @@
+/* ngpfg — 모든 NGPC 게임용 프레임 생성(코어 보간). 설명은 ngpfg.h. Legacito 내부 150.
+ *
+ * 그리기는 mednafen gfx.c 의 draw_scanline_colour / draw_scanline_mono 를 그대로 옮기되(창·배경색·반전·플레인 순서·
+ * 깊이 버퍼·스프라이트 순서·흑백 팔레트까지), 4배 격자에서 조각·스크롤을 ¼픽셀씩 옮겨 그린다. 옮김이 0 이면 원래 그림과
+ * 화소 하나까지 같다(시험 tools/ngpfg_test.c). */
+#include <string.h>
+#include <stdlib.h>
+#include "ngpfg.h"
+#ifdef NGPFG_DEBUG
+#include <stdio.h>
+int ngpfg_debug_line = -1;
+#endif
+
+/* ───────────── 캡처 ───────────── */
+#define FG_RING 8                  /* D-2·D-1·D + 숨겨 돌린 D+1·D+2 + 여유 */
+static ngpfg_frame fg_slot[FG_RING];
+static int fg_hist[FG_RING] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+static int fg_build = 0;
+static uint8_t fg_build_dirty;
+static long fg_stats[8];
+
+static int next_free(void)
+{
+   int i, k, used;
+   for (i = 0; i < FG_RING; i++)
+   {
+      used = 0;
+      for (k = 0; k < FG_RING - 1; k++) if (fg_hist[k] == i) used = 1;
+      if (!used) return i;
+   }
+   return fg_hist[FG_RING - 1] >= 0 ? fg_hist[FG_RING - 1] : 0;
+}
+
+void ngpfg_reset(void)
+{
+   int k;
+   memset(fg_slot, 0, sizeof fg_slot);
+   for (k = 0; k < FG_RING; k++) fg_hist[k] = -1;
+   fg_build = 0;
+   fg_build_dirty = 0;
+}
+
+void ngpfg_capture_line(int y, const ngpfg_regs *r)
+{
+   if (y < 0 || y >= NGPFG_H) return;
+   fg_slot[fg_build].line[y] = *r;
+}
+
+void ngpfg_capture_write(int dirty_bit) { fg_build_dirty |= (uint8_t)dirty_bit; }
+
+static inline uint16_t ld16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+
+/* 원본 렌더러의 스프라이트 자리 접기: 249..255 → -7..-1, 나머지는 하위 8비트 */
+static inline int fold(int v) { return (v > 248 && v < 256) ? v - 256 : (v & 0xFF); }
+
+static int16_t fg_ax[FG_RING][64], fg_ay[FG_RING][64];   /* 체인을 푼 절대 자리(오프셋 더하기 전) — 줄마다 오프셋이 다를 때 */
+
+static void derive(ngpfg_frame *f, int slot)
+{
+   int i, k, lx = 0, ly = 0, run = 0;
+   const ngpfg_regs *r0 = &f->line[0];
+   for (i = 0; i < 64; i++)
+   {
+      const uint8_t *s = f->spr + i * 4;
+      uint16_t a = (uint16_t)(s[0] | (s[1] << 8));
+      int x = s[2], y = s[3], prio = (a >> 11) & 3, blank = 1;
+      uint8_t palv;
+      const uint8_t *t;
+      uint64_t h = 1469598103934665603ULL;
+      if (a & 0x0400) x = lx + s[2];
+      if (a & 0x0200) y = ly + s[3];
+      lx = (int16_t)x; ly = (int16_t)y;       /* 원본은 int16 으로 쌓는다 */
+      if (i && !(a & 0x0600)) run++;
+      f->run[i] = (uint8_t)run;
+      fg_ax[slot][i] = (int16_t)lx; fg_ay[slot][i] = (int16_t)ly;
+      f->sx[i] = (int16_t)fold(lx + r0->spx);
+      f->sy[i] = (int16_t)fold(ly + r0->spy);
+      t = f->chr + (a & 0x01FF) * 16;
+      for (k = 0; k < 16; k++) if (t[k]) { blank = 0; break; }
+      palv = f->mono ? (uint8_t)((a >> 13) & 1) : (uint8_t)(f->sprcol[i] & 0x0F);
+      f->vis[i] = (uint8_t)(prio && !blank);
+      f->cls[i] = (uint8_t)((prio << 4) | palv);
+      for (k = 0; k < 16; k++) { h ^= t[k]; h *= 1099511628211ULL; }
+      h ^= (uint64_t)(a & 0xF800); h *= 1099511628211ULL;
+      h ^= palv; h *= 1099511628211ULL;
+      f->hash[i] = h;
+   }
+}
+
+void ngpfg_capture_end(const uint8_t *scroll, const uint8_t *chr, const uint8_t *spr,
+                       const uint8_t *sprcol, const uint8_t *pal, const uint8_t *mpal18, int mono, int layers)
+{
+   ngpfg_frame *f = &fg_slot[fg_build];
+   int k;
+   memcpy(f->scroll, scroll, sizeof f->scroll);
+   memcpy(f->chr,    chr,    sizeof f->chr);
+   memcpy(f->spr,    spr,    sizeof f->spr);
+   memcpy(f->sprcol, sprcol, sizeof f->sprcol);
+   memcpy(f->pal,    pal,    sizeof f->pal);
+   if (mpal18) memcpy(f->mpal, mpal18, sizeof f->mpal); else memset(f->mpal, 7, sizeof f->mpal);
+   f->mono   = (uint8_t)(mono != 0);
+   f->layers = (uint8_t)layers;
+   f->dirty  = fg_build_dirty;
+   f->valid  = 1;
+   derive(f, fg_build);
+   for (k = FG_RING - 1; k > 0; k--) fg_hist[k] = fg_hist[k - 1];
+   fg_hist[0] = fg_build;
+   fg_build = next_free();
+   fg_build_dirty = 0;
+   /* 다음 프레임 줄 레지스터는 지난 값으로 채워 둔다 — 못 채운 줄이 남지 않게 */
+   memcpy(fg_slot[fg_build].line, f->line, sizeof f->line);
+}
+
+void ngpfg_capture_pop(void)
+{
+   int k;
+   if (fg_hist[0] < 0) return;
+   fg_build = fg_hist[0];
+   for (k = 0; k < FG_RING - 1; k++) fg_hist[k] = fg_hist[k + 1];
+   fg_hist[FG_RING - 1] = -1;
+   fg_build_dirty = 0;
+}
+
+const ngpfg_frame *ngpfg_hist(int k)
+{
+   if (k < 0 || k >= FG_RING || fg_hist[k] < 0 || !fg_slot[fg_hist[k]].valid) return 0;
+   return &fg_slot[fg_hist[k]];
+}
+
+static int slot_of(const ngpfg_frame *f) { return (int)(f - fg_slot); }
+
+void ngpfg_stats(long *out8) { int i; for (i = 0; i < 8; i++) out8[i] = fg_stats[i]; }
+
+/* ───────────── 조각 짝짓기 ─────────────
+ * a 의 보이는 조각 k 마다, b 에서 겉모습이 같은 조각 j 의 자리 차이를 후보로 모은다(가까운 순, 최대 CAND).
+ * 이웃(같은 갈래 — 우선순위·팔레트 — 이고 16px 안, 또는 같은 체인)이 같은 후보를 많이 가진 것을 고른다(같으면 가까운 것).
+ * 그림이 바뀐 조각(포즈 바뀜)이나 우연히 맞은 조각은, 이웃 둘 넘게가 고른 벡터가 제 것보다 많으면 그것을 따른다. */
+typedef struct { int16_t vx, vy; uint8_t has; } fgvec;
+#define CAND 12
+static inline int wrap8s(int d) { d &= 255; return d >= 128 ? d - 256 : d; }
+static inline int iabs(int v) { return v < 0 ? -v : v; }
+
+static void match(const ngpfg_frame *a, const ngpfg_frame *b, fgvec out[64])
+{
+   int16_t cvx[64][CAND], cvy[64][CAND];
+   uint8_t cn[64];
+   uint64_t nb[64];
+   int bsup[64];
+   fgvec best[64];
+   int k, j, m, c;
+   memset(out, 0, sizeof(fgvec) * 64);
+   if (!a || !b || !a->valid || !b->valid || a->mono != b->mono) return;
+   if ((a->dirty | b->dirty) & NGPFG_DIRTY_SPR) return;
+   for (k = 0; k < 64; k++)
+   {
+      cn[k] = 0;
+      if (!a->vis[k]) continue;
+      for (j = 0; j < 64; j++)
+      {
+         int vx, vy, d, n, q;
+         if (!b->vis[j] || b->hash[j] != a->hash[k]) continue;
+         vx = wrap8s(b->sx[j] - a->sx[k]); vy = wrap8s(b->sy[j] - a->sy[k]);
+         if (iabs(vx) > NGPFG_MAX_STEP || iabs(vy) > NGPFG_MAX_STEP) continue;
+         d = iabs(vx) + iabs(vy);
+         n = cn[k];
+         for (q = 0; q < n; q++) if (cvx[k][q] == vx && cvy[k][q] == vy) break;
+         if (q < n) continue;                                   /* 같은 후보 */
+         if (n == CAND && d >= iabs(cvx[k][n - 1]) + iabs(cvy[k][n - 1])) continue;   /* 꽉 찼고 더 멀다 */
+         for (q = n < CAND ? n : CAND - 1; q > 0 && iabs(cvx[k][q - 1]) + iabs(cvy[k][q - 1]) > d; q--)
+         { cvx[k][q] = cvx[k][q - 1]; cvy[k][q] = cvy[k][q - 1]; }   /* 가까운 순으로 끼워 넣기(꽉 찼으면 맨 끝이 빠진다) */
+         cvx[k][q] = (int16_t)vx; cvy[k][q] = (int16_t)vy;
+         if (n < CAND) cn[k]++;
+      }
+   }
+   for (k = 0; k < 64; k++)
+   {
+      nb[k] = 0;
+      if (!a->vis[k]) continue;
+      for (m = 0; m < 64; m++)
+         if (a->vis[m] && a->cls[m] == a->cls[k] &&
+             (a->run[m] == a->run[k] || (iabs(a->sx[m] - a->sx[k]) <= 16 && iabs(a->sy[m] - a->sy[k]) <= 16)))
+            nb[k] |= 1ULL << m;
+   }
+   for (k = 0; k < 64; k++)
+   {
+      bsup[k] = 0; best[k].has = 0; best[k].vx = best[k].vy = 0;
+      for (c = 0; c < cn[k]; c++)
+      {
+         int sup = 0, q;
+         for (m = 0; m < 64; m++)
+         {
+            if (!(nb[k] >> m & 1)) continue;
+            for (q = 0; q < cn[m]; q++) if (cvx[m][q] == cvx[k][c] && cvy[m][q] == cvy[k][c]) { sup++; break; }
+         }
+         if (sup > bsup[k]) { bsup[k] = sup; best[k].vx = cvx[k][c]; best[k].vy = cvy[k][c]; best[k].has = 1; }
+      }
+   }
+   for (k = 0; k < 64; k++)
+   {
+      int bc = 0, bvx = 0, bvy = 0;
+      out[k] = best[k];
+      if (!a->vis[k]) continue;
+      /* 이웃들이 고른 벡터 중 가장 흔한 것 */
+      for (m = 0; m < 64; m++)
+      {
+         int cnt = 0, n2;
+         if (m == k || !(nb[k] >> m & 1) || !best[m].has) continue;
+         for (n2 = 0; n2 < 64; n2++)
+            if (n2 != k && (nb[k] >> n2 & 1) && best[n2].has && best[n2].vx == best[m].vx && best[n2].vy == best[m].vy) cnt++;
+         if (cnt > bc || (cnt == bc && iabs(best[m].vx) + iabs(best[m].vy) < iabs(bvx) + iabs(bvy)))
+         { bc = cnt; bvx = best[m].vx; bvy = best[m].vy; }
+      }
+      if (bc >= 2 && (!best[k].has || (bc > bsup[k] && (best[k].vx != bvx || best[k].vy != bvy))))
+      {
+         out[k].has = 1; out[k].vx = (int16_t)bvx; out[k].vy = (int16_t)bvy;
+      }
+   }
+}
+
+/* ───────────── 계획 ───────────── */
+static const ngpfg_frame *pl_f0, *pl_f1, *pl_f2;
+static int16_t pl_dx[2][64], pl_dy[2][64];         /* 칸마다 조각 옮김(¼ px) */
+static int16_t pl_sc[2][NGPFG_H][4];               /* 칸마다 줄·값(s1x s1y s2x s2y) 옮김(¼ px) — 스크롤 값이 커지는 쪽 */
+static uint8_t pl_kexp[NGPFG_H][2];                /* 줄·플레인마다 새로 드러나는 칸을 가져올 프레임(0 없음 · 1 D+1 · 2 D+2) */
+static int pl_ok = 0;
+
+/* τ = h/2 (h = 0·1) 에서 L→K 진행 — ¼ px 옮김 = 반올림(v·4·(h − 2L) / (2(K − L))) */
+static int qmove(int v, int K, int L, int h)
+{
+   int num, den, q;
+   if (!K || K <= L) return 0;
+   num = v * 4 * (h - 2 * L);                             /* (h − 2L) / (2(K − L)) 는 늘 0 이상 1 미만 */
+   den = 2 * (K - L);
+   q = num >= 0 ? (num + den / 2) / den : -((-num + den / 2) / den);
+   return q;
+}
+
+static inline uint8_t sp_val(const ngpfg_regs *r, int v) { return v == 0 ? r->s1x : v == 1 ? r->s1y : v == 2 ? r->s2x : r->s2y; }
+
+static int usable(const ngpfg_frame *f, const ngpfg_frame *f0)
+{
+   return f && f->valid && f->mono == f0->mono;
+}
+
+int ngpfg_plan(const ngpfg_frame *fm2, const ngpfg_frame *fm1, const ngpfg_frame *f0,
+               const ngpfg_frame *f1, const ngpfg_frame *f2)
+{
+   static fgvec b1[64], b2[64], g1[64], g2[64];
+   int k, y, v, h, any = 0;
+   pl_ok = 0;
+   memset(pl_dx, 0, sizeof pl_dx); memset(pl_dy, 0, sizeof pl_dy);
+   memset(pl_sc, 0, sizeof pl_sc); memset(pl_kexp, 0, sizeof pl_kexp);
+   if (!f0 || !f0->valid || (f0->dirty & (NGPFG_DIRTY_SPR | NGPFG_DIRTY_SCROLL))) { fg_stats[4]++; return -1; }
+   if (!usable(fm1, f0)) fm1 = 0;
+   if (!usable(fm2, f0) || !fm1) fm2 = 0;
+   if (!usable(f1, f0)) f1 = 0;
+   if (!usable(f2, f0) || !f1) f2 = 0;
+   pl_f0 = f0; pl_f1 = f1; pl_f2 = f2;
+   pl_ok = 1;
+   fg_stats[0]++;
+   match(f0, fm1, b1); match(f0, fm2, b2); match(f0, f1, g1); match(f0, f2, g2);
+   for (k = 0; k < 64; k++)
+   {
+      int K = 0, L, vx = 0, vy = 0, movedD, movedD1;
+      if (!f0->vis[k]) continue;
+      if (g1[k].has && (g1[k].vx || g1[k].vy)) { K = 1; vx = g1[k].vx; vy = g1[k].vy; }
+      else if (g1[k].has && g2[k].has && (g2[k].vx || g2[k].vy)) { K = 2; vx = g2[k].vx; vy = g2[k].vy; }
+      if (!K) { if (!g1[k].has) fg_stats[2]++; continue; }
+      movedD  = b1[k].has && (b1[k].vx || b1[k].vy);
+      movedD1 = b1[k].has && !b1[k].vx && !b1[k].vy && b2[k].has && (b2[k].vx || b2[k].vy);
+      {  /* 바로 앞 움직임과 거꾸로면(오락가락 — 맞을 때 흔들림·두 자리를 번갈아 찍는 깜빡임) 옮기지 않는다 — 원래처럼 끊어서 */
+         int lx = movedD ? -b1[k].vx : movedD1 ? -b2[k].vx : 0, ly = movedD ? -b1[k].vy : movedD1 ? -b2[k].vy : 0;
+         if (lx * vx + ly * vy < 0) { fg_stats[5]++; continue; }
+      }
+      L = movedD ? 0 : movedD1 ? -1 : K - 2;
+      if (L < K - 2) L = K - 2;
+      for (h = 0; h < 2; h++) { pl_dx[h][k] = (int16_t)qmove(vx, K, L, h); pl_dy[h][k] = (int16_t)qmove(vy, K, L, h); }
+      if (pl_dx[0][k] || pl_dy[0][k]) any |= 1;
+      if (pl_dx[1][k] || pl_dy[1][k]) any |= 2;
+      fg_stats[1]++;
+   }
+   if (f1)
+      for (y = 0; y < NGPFG_H; y++)
+         for (v = 0; v < 4; v++)
+         {
+            int c0 = sp_val(&f0->line[y], v), K = 0, L, d, db1 = 0, db2 = 0, df1 = 0, df2 = 0;
+            df1 = wrap8s(sp_val(&f1->line[y], v) - c0);
+            if (f2) df2 = wrap8s(sp_val(&f2->line[y], v) - sp_val(&f1->line[y], v));
+            if (fm1) db1 = wrap8s(c0 - sp_val(&fm1->line[y], v));
+            if (fm2) db2 = wrap8s(sp_val(&fm1->line[y], v) - sp_val(&fm2->line[y], v));
+            if (df1 && iabs(df1) <= NGPFG_MAX_STEP) { K = 1; d = df1; }
+            else if (!df1 && f2 && df2 && iabs(df2) <= NGPFG_MAX_STEP) { K = 2; d = df2; }
+            else continue;
+            {  /* 바로 앞 바뀜과 거꾸로면(오락가락 — 맞을 때 화면 흔들림·두 자리를 2 프레임마다 번갈아 쓰는 깜빡임) 안 옮긴다 */
+               int last = (fm1 && db1) ? db1 : (fm2 && db2) ? db2 : 0;
+               if (last && ((last > 0) != (d > 0))) { fg_stats[6]++; continue; }
+            }
+            L = (fm1 && db1 && iabs(db1) <= NGPFG_MAX_STEP) ? 0 : (fm2 && !db1 && db2 && iabs(db2) <= NGPFG_MAX_STEP) ? -1 : K - 2;
+            if (L < K - 2) L = K - 2;
+            for (h = 0; h < 2; h++)
+            {
+               pl_sc[h][y][v] = (int16_t)qmove(d, K, L, h);
+               if (pl_sc[h][y][v]) any |= 1 << h;
+            }
+            pl_kexp[y][v >> 1] = (uint8_t)K;
+            fg_stats[3]++;
+#ifdef NGPFG_DEBUG
+            if (y == ngpfg_debug_line)
+               fprintf(stderr, "plan y%d v%d: fm2 %d fm1 %d f0 %d f1 %d f2 %d | db1 %d db2 %d df1 %d df2 %d K%d L%d d%d → %d %d\n", y, v,
+                       fm2 ? sp_val(&fm2->line[y], v) : -1, fm1 ? sp_val(&fm1->line[y], v) : -1, c0,
+                       sp_val(&f1->line[y], v), f2 ? sp_val(&f2->line[y], v) : -1, db1, db2, df1, df2, K, L, d, pl_sc[0][y][v], pl_sc[1][y][v]);
+#endif
+         }
+   return any;
+}
+
+/* ───────────── 그리기 ─────────────
+ * S 배 격자(1 또는 4)에서 한 줄(y)의 한 겹(s = 0..S-1)을 12비트 색으로. 옮김은 S 배 화소 단위. */
+#define ZD_BACK_SCROLL  3
+#define ZD_FRONT_SCROLL 5
+
+static inline uint16_t mono_col(int lvl)
+{
+   uint16_t r = (uint16_t)((lvl & 7) << 1), g = (uint16_t)((lvl & 7) << 5), b = (uint16_t)((lvl & 7) << 9);
+   return (uint16_t)~(r | g | b);
+}
+
+/* 플레인 한 줄(맵 줄 py, 0..255)의 256 화소 — 색(반전 반영, 12비트)과 불투명 표시.
+   fx 가 있으면 «D 에서 안 보이던 칸»(visc·visr 밖)은 fx 의 맵으로(옮겨 그릴 때 새로 드러나는 칸) */
+static void plane_row(const ngpfg_frame *f, const ngpfg_frame *fx, const uint8_t *visc, uint32_t visr,
+                      int plane, int py, int neg, uint16_t *row, uint8_t *opq)
+{
+   int i, p, mrow = (py >> 3) & 31, ty0 = py & 7;
+   int fx_row = fx && !((visr >> mrow) & 1);
+   for (i = 0; i < 32; i++)
+   {
+      const ngpfg_frame *src = (fx && (fx_row || !visc[i])) ? fx : f;
+      const uint8_t *map = src->scroll + (plane == 2 ? 0x0800 : 0);
+      uint16_t e = ld16(map + ((i + (mrow << 5)) << 1));
+      int ty = (e & 0x4000) ? 7 - ty0 : ty0;
+      uint16_t data = ld16(src->chr + (e & 0x01FF) * 16 + ty * 2);
+      int mirror = (e & 0x8000) != 0;
+      for (p = 0; p < 8; p++)
+      {
+         int q = mirror ? 7 - p : p;
+         int idx = (data >> (14 - 2 * q)) & 3;
+         int px = i * 8 + p;
+         if (!idx) { opq[px] = 0; continue; }
+         opq[px] = 1;
+         if (!src->mono)
+         {
+            const uint8_t *pb = src->pal + (plane == 2 ? 0x0100 : 0x0080);
+            uint16_t c = ld16(pb + ((((e & 0x1E00) >> 9) << 2) + idx) * 2);
+            row[px] = (uint16_t)((neg ? (uint16_t)~c : c) & 0x0FFF);
+         }
+         else
+         {
+            const uint8_t *mp = src->mpal + (plane == 2 ? 12 : 6);
+            uint16_t c = mono_col(mp[((e & 0x2000) ? 3 : 0) + idx - 1]);
+            row[px] = (uint16_t)((neg ? (uint16_t)~c : c) & 0x0FFF);
+         }
+      }
+   }
+}
+
+typedef struct { int py, fxk, neg; uint16_t row[256]; uint8_t opq[256]; } prow_t;
+
+static void render_line(const ngpfg_frame *f, int y, int s, int S, const int16_t *sdisp /* [4] 이 줄 스크롤 옮김(S배 화소) */,
+                        const int16_t *dx, const int16_t *dy /* [64] 조각 옮김(S배 화소) — NULL 이면 0 */,
+                        const ngpfg_frame *fx1, const ngpfg_frame *fx2, const uint8_t *kexp,
+                        const uint8_t visc[2][32], const uint32_t *visr, prow_t *cache, uint16_t *col, uint8_t *z)
+{
+   const ngpfg_regs *r = &f->line[y];
+   int W = NGPFG_W * S, X, wx0 = r->winx, wx1 = r->winx + r->winw, inwin, i, pass;
+   uint16_t oc, bc;
+   if (wx1 > NGPFG_W) wx1 = NGPFG_W;
+   if (wx0 > NGPFG_W) wx0 = NGPFG_W;
+   inwin = y >= r->winy && y < r->winy + r->winh;
+   if (!f->mono)
+   {
+      oc = ld16(f->pal + 0x01F0 + ((r->oowc & 7) << 1));
+      bc = ld16(f->pal + 0x01E0 + ((r->bgc & 7) << 1));
+   }
+   else
+   {
+      oc = mono_col(r->oowc & 7);
+      bc = ((r->bgc & 0xC0) == 0x80) ? mono_col(r->bgc & 7) : 0x0FFF;
+   }
+   if (r->neg) { oc = (uint16_t)~oc; bc = (uint16_t)~bc; }
+   oc &= 0x0FFF; bc &= 0x0FFF;
+   for (X = 0; X < W; X++) { col[X] = oc; z[X] = 0; }
+   if (!inwin || wx0 >= wx1) return;
+   for (X = wx0 * S; X < wx1 * S; X++) col[X] = bc;
+   /* 플레인: 뒤 → 앞 */
+   for (pass = 0; pass < 2; pass++)
+   {
+      int plane = r->swap ? (pass == 0 ? 1 : 2) : (pass == 0 ? 2 : 1);
+      int bit = pass == 0 ? 1 : 2, depth = pass == 0 ? ZD_BACK_SCROLL : ZD_FRONT_SCROLL;
+      int vx = plane == 1 ? 0 : 2, sx = plane == 1 ? r->s1x : r->s2x, sy = plane == 1 ? r->s1y : r->s2y;
+      int ex = sdisp ? sdisp[vx] : 0, ey = sdisp ? sdisp[vx + 1] : 0, py4, py, off;
+      int fk = kexp ? kexp[plane - 1] : 0;
+      const ngpfg_frame *fx = fk == 1 ? fx1 : fk == 2 ? fx2 : 0;
+      prow_t *pr = &cache[plane - 1];
+      if (!(f->layers & bit)) continue;
+      py4 = S * (y + sy) + s + ey;
+      py = (py4 >= 0 ? py4 / S : -((-py4 + S - 1) / S)) & 0xFF;
+      if (pr->py != py || pr->fxk != fk || pr->neg != r->neg)
+      {
+         plane_row(f, fx, visc[plane - 1], visr[plane - 1], plane, py, r->neg, pr->row, pr->opq);
+         pr->py = py; pr->fxk = fk; pr->neg = r->neg;
+      }
+      off = S * sx + ex;                     /* 플레인 x(S배) = X + off */
+      for (X = wx0 * S; X < wx1 * S; X++)
+      {
+         int px4 = X + off, px = (px4 >= 0 ? px4 / S : -((-px4 + S - 1) / S)) & 0xFF;
+         if (!pr->opq[px] || depth <= z[X]) continue;
+         z[X] = (uint8_t)depth; col[X] = pr->row[px];
+      }
+   }
+   /* 스프라이트: 0 → 63, 같은 깊이는 앞 번호가 이긴다(원본과 같음) */
+   if (f->layers & 4)
+   {
+      int sl = slot_of(f);
+      const uint8_t *mp = f->mpal;
+      for (i = 0; i < 64; i++)
+      {
+         uint16_t a;
+         int prio, xs, ys, X0, Y0, r4, tr, p, depth;
+         uint16_t data;
+         if (!f->vis[i]) continue;
+         a = ld16(f->spr + i * 4);
+         prio = (a >> 11) & 3; depth = prio << 1;
+         xs = fold(fg_ax[sl][i] + r->spx); ys = fold(fg_ay[sl][i] + r->spy);
+         Y0 = S * ys + (dy ? dy[i] : 0);
+         r4 = S * y + s - Y0;
+         if (r4 < 0 || r4 >= 8 * S) continue;
+         tr = r4 / S; if (a & 0x4000) tr = 7 - tr;
+         data = ld16(f->chr + (a & 0x01FF) * 16 + tr * 2);
+         X0 = S * xs + (dx ? dx[i] : 0);
+         for (p = 0; p < 8; p++)
+         {
+            int q = (a & 0x8000) ? 7 - p : p, idx = (data >> (14 - 2 * q)) & 3, xa, xb;
+            uint16_t c;
+            if (!idx) continue;
+            xa = X0 + p * S; xb = xa + S;
+            if (xa < wx0 * S) xa = wx0 * S;
+            if (xb > wx1 * S) xb = wx1 * S;
+            if (xa >= xb) continue;
+            if (!f->mono) c = ld16(f->pal + (((f->sprcol[i] & 0x0F) << 2) + idx) * 2);
+            else c = mono_col(mp[((a & 0x2000) ? 3 : 0) + idx - 1]);
+            if (r->neg) c = (uint16_t)~c;
+            c &= 0x0FFF;
+            for (X = xa; X < xb; X++) { if (depth <= z[X]) continue; z[X] = (uint8_t)depth; col[X] = c; }
+         }
+      }
+   }
+}
+
+/* D 에서 보이던 맵 칸(가로: 줄마다 다르지만 0줄·가운데 줄 둘로 넉넉히 · 세로: 모든 줄) */
+static void visible_cells(const ngpfg_frame *f, uint8_t visc[2][32], uint32_t visr[2])
+{
+   int p, y, c;
+   memset(visc, 0, 64);
+   visr[0] = visr[1] = 0;
+   for (p = 0; p < 2; p++)
+      for (y = 0; y < NGPFG_H; y++)
+      {
+         const ngpfg_regs *r = &f->line[y];
+         int sx = p == 0 ? r->s1x : r->s2x, sy = p == 0 ? r->s1y : r->s2y;
+         visr[p] |= 1u << ((((y + sy) & 0xFF) >> 3) & 31);
+         if (y == 0 || y == NGPFG_H / 2 || y == NGPFG_H - 1)
+            for (c = 0; c < 21; c++) visc[p][((sx >> 3) + c) & 31] = 1;
+      }
+}
+
+static uint16_t rl_col[NGPFG_W * 4];
+static uint8_t  rl_z[NGPFG_W * 4];
+
+int ngpfg_render1(const ngpfg_frame *f, uint16_t *dst, int pitch_px, const uint32_t *colormap)
+{
+   int y, X;
+   prow_t cache[2];
+   uint8_t visc[2][32];
+   uint32_t visr[2];
+   if (!f || !f->valid) return 0;
+   cache[0].py = cache[1].py = -1; cache[0].fxk = cache[1].fxk = 0;
+   visible_cells(f, visc, visr);
+   for (y = 0; y < NGPFG_H; y++)
+   {
+      uint16_t *o = dst + (size_t)y * pitch_px;
+      cache[0].py = cache[1].py = -1;
+      render_line(f, y, 0, 1, 0, 0, 0, 0, 0, 0, (const uint8_t (*)[32])visc, visr, cache, rl_col, rl_z);
+      for (X = 0; X < NGPFG_W; X++) o[X] = (uint16_t)colormap[rl_col[X] & 4095];
+   }
+   return 1;
+}
+
+int ngpfg_render4(int slot, uint16_t *dst, int pitch_px, const uint32_t *colormap)
+{
+   const ngpfg_frame *f = pl_f0;
+   int y, s, X, i, h = slot ? 1 : 0;
+   uint8_t vary[NGPFG_H];
+   prow_t cache[2];
+   uint8_t visc[2][32];
+   uint32_t visr[2];
+   if (!pl_ok || !f) return 0;
+   cache[0].py = cache[1].py = -1; cache[0].fxk = cache[1].fxk = 0;
+   visible_cells(f, visc, visr);
+   /* 줄마다 네 겹이 다른가 — 세로로 ¼px 옮긴 플레인이나 조각이 걸친 줄만 겹마다 다시 그린다(나머지는 베낀다) */
+   memset(vary, 0, sizeof vary);
+   for (y = 0; y < NGPFG_H; y++)
+      if ((pl_sc[h][y][1] & 3) || (pl_sc[h][y][3] & 3)) vary[y] = 1;
+   for (i = 0; i < 64; i++)
+   {
+      int y0, y1, Y0;
+      if (!f->vis[i] || !(pl_dy[h][i] & 3)) continue;
+      Y0 = 4 * f->sy[i] + pl_dy[h][i];
+      y0 = (Y0 >= 0 ? Y0 / 4 : -((-Y0 + 3) / 4)) - 1; y1 = (Y0 + 31) / 4 + 1;
+      for (y = y0; y <= y1; y++) if (y >= 0 && y < NGPFG_H) vary[y] = 1;
+   }
+   for (y = 0; y < NGPFG_H; y++)
+   {
+      for (s = 0; s < 4; s++)
+      {
+         uint16_t *o = dst + (size_t)(4 * y + s) * pitch_px;
+         if (s && !vary[y]) { memcpy(o, dst + (size_t)(4 * y) * pitch_px, NGPFG_W * 4 * sizeof(uint16_t)); continue; }
+         render_line(f, y, s, 4, pl_sc[h][y], pl_dx[h], pl_dy[h], pl_f1, pl_f2, pl_kexp[y],
+                     (const uint8_t (*)[32])visc, visr, cache, rl_col, rl_z);
+         for (X = 0; X < NGPFG_W * 4; X++) o[X] = (uint16_t)colormap[rl_col[X] & 4095];
+      }
+   }
+   return 1;
+}
diff -ruN pa/build/ngpfg.h pb/build/ngpfg.h
--- a/build/ngpfg.h	1970-01-01 09:00:00.000000000 +0900
+++ b/build/ngpfg.h	2026-10-16 18:10:50.018731183 +0900
@@ -0,0 +1,79 @@
+/* ngpfg — 모든 NGPC 게임용 프레임 생성(코어 보간). Legacito 내부 150.
+ *
+ * 사무쇼2 코어의 ss2fg 는 사무쇼2 RAM(몸 위치·물체 표)에 기대 몸을 옮긴다. 이건 게임을 모르는 판:
+ * K2GE 의 스프라이트 64개·스크롤 플레인 2장을 프레임마다 캡처해 두고, 앞뒤 프레임(D-2 … D+2, 뒤 둘은 예측으로 미리 돌린 것)
+ * 사이에서 «같은 그림 조각»이 어디로 갔는지 이웃 조각들의 합의로 찾아, 그 조각을 게임 박자(30Hz 면 ¼씩)에 맞춘
+ * ¼픽셀 자리에 D 의 타일·팔레트 그대로 4배(640×608)로 다시 그린다. 픽셀을 섞지 않는다 — 도트가 안 뭉개진다.
+ *
+ * 쓰는 쪽:
+ *   gfx.c     — 스캔라인마다 ngpfg_capture_line(), V-int 에서 ngpfg_capture_end(), 표시 중 VRAM 쓰기에 ngpfg_capture_write()
+ *   libretro.c — 실제 프레임 D 뒤 D+1·D+2 를 숨겨 돌려 캡처 → ngpfg_plan() → ngpfg_render4(칸 0 = τD, 1 = τD+½) → 되돌림
+ * mednafen 헤더에 기대지 않는다(호스트 시험이 그대로 쓴다). */
+#ifndef NGPFG_H_INCLUDED
+#define NGPFG_H_INCLUDED
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NGPFG_W 160
+#define NGPFG_H 152
+
+/* 스캔라인을 그리는 순간의 지연 레지스터(ngpgfx_delayed_settings 가 반영한 값) */
+typedef struct ngpfg_regs {
+   uint8_t winx, winw, winy, winh;
+   uint8_t s1x, s1y, s2x, s2y;     /* 스크롤 플레인 1·2 */
+   uint8_t spx, spy;               /* 스프라이트 오프셋 */
+   uint8_t swap, bgc, oowc, neg;   /* 플레인 순서 교환, 배경색(흑백 모드는 원값), 창밖색, 반전 */
+} ngpfg_regs;
+
+#define NGPFG_DIRTY_SPR    1
+#define NGPFG_DIRTY_SCROLL 2
+#define NGPFG_DIRTY_CHR    4
+#define NGPFG_DIRTY_PAL    8
+
+typedef struct ngpfg_frame {
+   ngpfg_regs line[NGPFG_H];
+   uint8_t scroll[4096];           /* 9000-9fff 타일맵 2장 */
+   uint8_t chr[8192];              /* a000-bfff 타일 */
+   uint8_t spr[256];               /* 8800-88ff 스프라이트표 */
+   uint8_t sprcol[64];             /* 8c00-8c3f 스프라이트 팔레트 번호 */
+   uint8_t pal[512];               /* 8200-83ff 컬러 팔레트 */
+   uint8_t mpal[18];               /* 흑백 모드 팔레트 SPPLT·SCRP1PLT·SCRP2PLT */
+   uint8_t mono, valid, dirty, layers;
+   /* 캡처 때 계산 */
+   int16_t sx[64], sy[64];         /* 화면 자리(체인 + 0줄 오프셋, 원본과 같은 접기: -7..255) */
+   uint8_t vis[64];                /* 그릴 조각(우선순위 ≠ 0, 그림이 빈 타일이 아님) */
+   uint8_t cls[64];                /* 이웃 판정용 갈래(우선순위·팔레트) */
+   uint8_t run[64];                /* 체인 묶음 번호 */
+   uint64_t hash[64];              /* 겉모습(타일 그림 16바이트·플립·우선순위·팔레트) */
+} ngpfg_frame;
+
+/* ── 캡처 ── */
+void ngpfg_reset(void);
+void ngpfg_capture_line(int y, const ngpfg_regs *r);
+void ngpfg_capture_end(const uint8_t *scroll, const uint8_t *chr, const uint8_t *spr,
+                       const uint8_t *sprcol, const uint8_t *pal, const uint8_t *mpal18, int mono, int layers);
+void ngpfg_capture_write(int dirty_bit);   /* 표시 중(1..151줄) VRAM 쓰기 */
+void ngpfg_capture_pop(void);              /* 마지막 capture_end 를 무른다(숨겨 돌린 프레임 되돌리기) */
+const ngpfg_frame *ngpfg_hist(int k);      /* k 장 전 캡처 (0 = 마지막) */
+
+/* ── 계획·그리기 ──
+ * plan: D(f0) 의 조각·스크롤마다 «지난 바뀜 L(≤0)·다음 바뀜 K(1|2)»를 앞뒤 프레임에서 찾아, 칸 0(τD)·칸 1(τD+½)의 옮김을
+ *       ¼픽셀로 정한다. 없는 프레임은 NULL. 반환 비트0 = 칸 0 에 옮길 것이 있음, 비트1 = 칸 1 에. -1 = 합성 불가(그대로 내보낼 것).
+ * render4: 그 칸을 4배(640×608, 16비트 색표 colormap)로 dst 에. 반환 1 = 그렸다. */
+int  ngpfg_plan(const ngpfg_frame *fm2, const ngpfg_frame *fm1, const ngpfg_frame *f0,
+                const ngpfg_frame *f1, const ngpfg_frame *f2);
+int  ngpfg_render4(int slot, uint16_t *dst, int pitch_px, const uint32_t *colormap);
+/* 시험용: 옮김 없이(0) 1배로 다시 그리기 — 원래 그림과 화소가 같아야 한다 */
+int  ngpfg_render1(const ngpfg_frame *f, uint16_t *dst, int pitch_px, const uint32_t *colormap);
+void ngpfg_stats(long *out8);      /* 계기: 계획한 프레임 / 옮긴 조각 / 짝 못 찾은 조각 / 옮긴 스크롤 줄 / 합성 불가 / … */
+
+#define NGPFG_MAX_STEP 40          /* 한 걸음에 이보다 멀리 간 조각·스크롤은 안 옮긴다(순간이동·장면 전환) */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
