+         static char text[256];
+         fg_slow_secs = 0; fg_ok_secs = 0;
+         fg_rate_block = 1;
+         fg_block_t0   = now;
+         if (fg_block_n < FG_BLOCK_RETRIES + 1) fg_block_n++;
+         fg_apply(0);
