+/* 1배 합성 그림(comp — 띠·토스트·오버레이 포함, w=160 × h)을 4배로 늘려 out 에. 게임 줄(gy0 부터 152 줄)은, 1배 화소가
+   게임 원래 그림(real)과 같은 곳이면(토스트가 덮지 않은 곳) 그린 4배(syn)의 4×4 칸으로. syn 이 NULL 이면 그냥 늘리기 */
+static void fg_compose(uint16_t *out, const uint16_t *comp, int h, const uint16_t *real, int gy0, const uint16_t *syn)
+{
+   int y, x, s;
+   for (y = 0; y < h; y++)
+   {
+      int gy = y - gy0, game = syn && gy >= 0 && gy < FB_HEIGHT;
+      const uint16_t *cr = comp + (size_t)y * FB_WIDTH;
+      const uint16_t *rr = game ? real + (size_t)gy * FB_WIDTH : 0;
+      uint16_t *o0 = out + (size_t)(4 * y) * FG_OUT_W;
+      for (x = 0; x < FB_WIDTH; x++)
+      {
+         uint16_t *o = o0 + 4 * x;
+         if (game && cr[x] == rr[x])
+         {
+            const uint16_t *si = syn + (size_t)(4 * gy) * FG_OUT_W + 4 * x;
+            for (s = 0; s < 4; s++) memcpy(o + (size_t)s * FG_OUT_W, si + (size_t)s * FG_OUT_W, 4 * sizeof(uint16_t));
+         }
+         else
+         {
+            uint16_t c = cr[x];
+            for (s = 0; s < 4; s++) { uint16_t *q = o + (size_t)s * FG_OUT_W; q[0] = q[1] = q[2] = q[3] = c; }
+         }
+      }
+   }
+}
