+static int fg_plan_frame(void)
+{
+   int bits;
+   if (!ngpfg_hist(0)) return -1;
+   if (!fg_snap_save()) return -1;
+   fg_hidden(2);
+   bits = ngpfg_plan(ngpfg_hist(4), ngpfg_hist(3), ngpfg_hist(2), ngpfg_hist(1), ngpfg_hist(0));
+   return bits;                                  /* 그리기는 아직 — 숨은 프레임 캡처가 링에 있는 동안(fg_plan_done 전에) */
+}
+static void fg_plan_done(void) { fg_snap_load(2); }
