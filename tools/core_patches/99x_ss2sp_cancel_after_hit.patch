+   q_n = q_i = 0;
+   q[q_n].pad = inj_fin; q[q_n].frames = 2; q[q_n].sustain = 0; q_n++;
+   q[q_n].pad = 0; q[q_n].frames = TAIL_FRAMES; q[q_n].sustain = 0; q_n++;
+   q_left = q[0].frames;
+   qr_attempt = 1; q_inj = 1;
+   if (ss2_dbg()) fprintf(stderr, "[ss2sp] repress %d c=%d\n", qr_tries, c);
+   return 1;
+}
