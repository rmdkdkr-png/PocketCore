+               ss2fg_render(ss2fg_cur(), ss2fg_prev(), 128, (uint16_t *)surf->pixels, FB_WIDTH, NGPGfx->ColorMap);
+            else if (fg_mult == 4 && !hidden && !ngplink_active()) /* 4배: 지금 그림도 박자에 맞춰 옮겨 그린다 */
+               fg_next_ok = fg_predict4(ra);
+         }
+         else if (ra)
+            ra_plain(ra);                                          /* 프레임 생성 없이 런어헤드만 */
       }
 
