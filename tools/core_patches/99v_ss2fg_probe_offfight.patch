+static void probe_check(const ss2fg_frame *f)
+{
+   uint8_t mm[64];
+   uint64_t s;
+   pb.pos++;
+   if (!pb.on || pb.found) return;
+   if (!f->valid || f->mono || !f->body_ok || !body_mask(f, pb.p, mm)) { pb.on = 0; return; }      /* 몸이 없어짐 */
