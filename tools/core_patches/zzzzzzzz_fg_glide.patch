+/* zzzzzzzz_fg_glide: 한 포즈 걸음 그림 — 사무쇼2 는 걷기·뒷걸음·대시의 상당수가 «포즈 하나로 땅을 감»이다(서기 자세 그대로 다가옴:
+   샬럿 72px · 리무루루 87px · 나코루루 53px 등, 대시는 거의 모두 한 포즈로 22px — 봇 35판). 120Hz 로 몸을 옮기든 원작처럼 디디든
+   다리가 안 움직여 미끄러져 다가온다(유저 10-19 「나에게 다가올 때 문제」·「나코루루 시키 등」·「다시 그리는 방법이 있나」).
+   캐시에 «같은 포즈 → 같은 포즈»(P, P) 항목이 있으면 그 세 장(새로 그린 걸음 그림)을 간 거리로 돌려 그린다:
+   P → ① → ② → ③ → P … 한 장에 GL_STEP px. 포즈가 바뀔 게 보이면(미리 돌린 D+1·D+2) 바뀜 사이 그림(mc_plan)에 맡긴다.
+   세 장은 «앞으로(상대 쪽으로) 걷는» 차례로 그린다 — 상대에게서 멀어지면(뒷걸음) 거꾸로(P → ③ → ② → ① …) 돌려 뒤로 걷게.
+   첫 걸음은 반 장(GL_STEP/2) 만에 — 짧게 다가와도(샬럿 한 번에 15px 등) 다리가 한 번은 움직이게.
+   (P, P) 항목이 없으면 아무 일도 안 한다 */
+#define GL_STEP 8
+static int      gl_mode = 1;                 /* 0 끔 · 1 켬(호스트 시험 SS2_GLIDE) */
+static uint64_t gl_sig[2];                   /* 거리를 재는 포즈 */
+static int      gl_dist[2];                  /* 그 포즈로 땅 위에서 간 거리(px) — 상대 쪽 +, 멀어지는 쪽 − */
+static unsigned gl_mv[2];                    /* 마지막으로 움직인 실제 프레임 */
+static uint8_t  gl_wx[2], gl_ct[2];
+static int      gl_stats[4];                 /* 장마다 그린 수(0 = 원래 포즈) */
+void ss2fg_set_glide(int m) { gl_mode = m; }
+void ss2fg_glide_stats(int *o4) { int i; for (i = 0; i < 4; i++) o4[i] = gl_stats[i]; }
+static int gl_ctok(uint8_t ct) { return ct == 0 || ct == 4 || ct == 6; }
+static void gl_observe(const ss2fg_frame *f, int p, uint64_t sg, unsigned realn)
+{
+   int d;
+   if (!sg || !f->fight || (f->st[p] & 0xE0) != 0x20 || !gl_ctok(f->ct[p]) || sg != gl_sig[p] || f->ct[p] != gl_ct[p])
+   { gl_sig[p] = sg; gl_ct[p] = f->ct[p]; gl_dist[p] = 0; gl_mv[p] = 0; gl_wx[p] = f->wx[p]; return; }
+   d = (int8_t)(uint8_t)(f->wx[p] - gl_wx[p]);
+   if (d && d >= -12 && d <= 12)
+   {
+      int to = (int8_t)(uint8_t)(f->wx[1 - p] - f->wx[p]);    /* 상대가 있는 쪽 */
+      gl_dist[p] += (to && (d > 0) != (to > 0)) ? -(d < 0 ? -d : d) : (d < 0 ? -d : d);
+      gl_mv[p] = realn;
+   }
+   gl_wx[p] = f->wx[p];
+}
+/* 반환: 1 = 걸음 그림을 계획함 · -1 = 걷는 중이지만 이번 장은 원래 포즈(다른 사이 그림도 안 씀) · 0 = 해당 없음 */
+static int gl_plan(const ss2fg_frame *f0, const ss2fg_frame *f1, const ss2fg_frame *f2, unsigned realn, int slot, int p)
+{
+   uint8_t mm[64];
+   int k, ph, moving = 0, ax0, ay0;
+   mc_ent *e;
+   id_pose *A;
+   id_req_t *rq = &id_rq[slot][p];
+   if (!gl_mode || !mc_on || !mc_f || !id_cur[p] || !f0->fight || f0->pick || gl_sig[p] != id_cur[p]) return 0;
+   if ((f0->st[p] & 0xE0) != 0x20 || !gl_ctok(f0->ct[p]) || f0->ct[p] != gl_ct[p]) return 0;
+   if (!mc_has(id_cur[p], id_cur[p])) return 0;
+   for (k = 1; k <= 2; k++)
+   {
+      const ss2fg_frame *g = k == 1 ? f1 : f2;
+      if (!g || !g->valid || g->mono || !g->body_ok || !body_mask(g, p, mm)) break;
+      if (body_sig(g, mm) != id_cur[p]) return 0;             /* 곧 다른 포즈 — 바뀜 사이 그림으로 */
+      if (g->wx[p] != f0->wx[p] && (g->st[p] & 0xE0) == 0x20) moving = 1;
+   }
+   if (gl_mv[p] && realn - gl_mv[p] <= 6u) moving = 1;      /* 걸음 사이 쉼(4 프레임)도 걷는 중 */
+   if (!moving) return 0;
+   {
+      int q = gl_dist[p] + GL_STEP / 2;
+      ph = (q >= 0 ? q / GL_STEP : -((-q + GL_STEP - 1) / GL_STEP)) & 3;   /* 내림 나눗셈 — 뒷걸음은 ③ ② ① */
+   }
+   if (!ph) { if (slot == 0) gl_stats[0]++; return -1; }
+   if (!(e = mc_get(id_cur[p], id_cur[p]))) return 0;
+   A = id_find_pose(p, id_cur[p]);
+   if (!A || A->w != e->aw || A->h != e->ah || A->w != e->bw || A->h != e->bh || e->bdx || e->bdy) { mc_stats[3]++; return 0; }
+   if (!mc_top_left(f0, p, &ax0, &ay0)) { ax0 = A->ox; ay0 = A->oy; }
+   rq->on = 1; rq->kind = 1; rq->pr = 0; rq->t256 = 64 * ph;
+   rq->e = e; rq->ti = ph - 1; rq->A = A; rq->B = A;
+   rq->gx = ax0 + e->cx; rq->gy = ay0 + e->cy; rq->sx4 = rq->sy4 = 0;
+   rq->ax = f0->ob_x[p]; rq->ay = f0->ob_y[p];
+   rq->gw = e->w; rq->gh = e->h;
+   rq->depth = A->depth; rq->first = A->first;
+   if (slot == 0) gl_stats[ph]++;
+   return 1;
+}
