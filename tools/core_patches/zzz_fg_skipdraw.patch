 extern int ngplink_active(void);
 int ngp_fg_mute = 0;                      /* sound.cpp 가 본다 — 예측 프레임 중 소리 무시 */
+int ngp_fg_skipdraw = 0;                  /* zzz_fg_skipdraw: interrupt.c 가 본다 — 그림을 안 쓸 숨은 프레임은 줄 그리기를 건너뜀(캡처는 그대로) */
 extern int ngp_fg_predict;                /* mem.c — 예측 프레임 중 롬/플래시 쓰기 차단 */
 extern void ngp_mem_fg_extras(uint8_t *buf, int load);
 extern int iline;                         /* z80_ops.c — Z80 인터럽트선, 어떤 StateAction 에도 없다 */
@@ -691,9 +692,14 @@ static void fg_hidden(int n, int keep)
    for (k = 1; k <= n; k++)
    {
       ps.SoundBufSize = 0;
+      /* zzz_fg_skipdraw: 그림을 남기지 않는 숨은 프레임(keep 아닌 것) — 줄 그리기만 건너뛴다. 프레임 패치는 숨은 프레임의 그림을 안 쓰고
+         캡처한 레지스터·VRAM 으로 다시 그린다(색칠된 surf 는 곧 덮임·멀리 미리 보기는 되돌림). 게임 진행·캡처는 같다 — 호스트 12 갈래
+         (예측·보간·2배·60Hz·런어헤드 2, 봇·걷기) 출력·쪽지 해시가 한 장도 안 다름. 숨은 프레임이 실제 프레임마다 2~8 장이라 CPU 를 꽤 먹었다 */
+      ngp_fg_skipdraw = k != keep;
       Emulate(&ps, fg_scratch_snd);                /* 입력은 마지막 실제 프레임 값 그대로(붙잡고 있다고 가정) */
       if (k == keep) memcpy(fg_real, surf->pixels, sizeof fg_real);
    }
+   ngp_fg_skipdraw = 0;
    ngp_fg_mute = 0; ngp_fg_predict = 0;
 }
 
