+static void fx_reset_slot(int slot) { int i; for (i = 0; i < FX_N; i++) fx_rq[slot][i].on = 0; }
+/* 무리 그림: 슬롯 큰 조각부터 그려 작은 슬롯이 위. out = 색 번호(0 빈칸) 또는 pic 이면 팔레트<<2|색(빈칸 ID_NONE) */
+static void fx_draw_grp(const ss2fg_frame *f, const fx_grp *g, uint8_t *idx, uint16_t *pic)
+{
+   const ss2fg_regs *r = &f->line[0];
+   int w = g->x1 - g->x0, hh = g->y1 - g->y0, k, row, col;
+   if (idx) memset(idx, 0, (size_t)w * hh);
+   if (pic) for (k = 0; k < w * hh; k++) pic[k] = ID_NONE;
+   for (k = 63; k >= 0; k--)
+   {
+      uint16_t wd;
+      unsigned tile;
+      int sx, sy;
+      if (!g->m[k]) continue;
+      wd = ld16(f->spr + k * 4);
+      tile = wd & 0x01FF;
+      sx = wrapx(f->ax[k] + r->spx) - g->x0; sy = wrapc(f->ay[k] + r->spy) - g->y0;
+      for (row = 0; row < 8; row++)
+      {
+         unsigned rr = (wd & 0x4000) ? 7 - row : row;
+         int v = ld16(f->chr + tile * 16 + rr * 2);
+         if (wd & 0x8000) v = mirrored[(v & 0xff00) >> 8] | (mirrored[v & 0xff] << 8);
+         for (col = 0; col < 8; col++)
+         {
+            int ci = (v >> (2 * (7 - col))) & 3, yy = sy + row, xx = sx + col;
+            if (!ci || yy < 0 || yy >= hh || xx < 0 || xx >= w) continue;
+            if (idx) idx[yy * w + xx] = (uint8_t)ci;
+            if (pic) pic[yy * w + xx] = (uint16_t)((g->pal << 2) | ci);
+         }
+      }
+   }
+}
+static int fx_groups(const ss2fg_frame *f, fx_grp *out, int max)
+{
+   uint8_t b0[64], b1[64], cand[64], used[64];
+   static uint8_t idx[ID_W * ID_H];
+   int px[64], py[64], k, n = 0;
+   const ss2fg_regs *r;
+   if (!f || !f->valid || f->mono) return 0;
+   r = &f->line[0];
+   memset(b0, 0, sizeof b0); memset(b1, 0, sizeof b1);
+   if (f->body_ok) { body_mask(f, 0, b0); body_mask(f, 1, b1); }
+   for (k = 0; k < 64; k++)
+   {
+      uint16_t w = ld16(f->spr + k * 4);
+      cand[k] = used[k] = 0;
+      if (!(w & 0x1800) || b0[k] || b1[k] || (f->sprcol[k] & 15) == 12) continue;
+      px[k] = wrapx(f->ax[k] + r->spx); py[k] = wrapc(f->ay[k] + r->spy);
+      if (py[k] <= -8 || py[k] >= SS2FG_H) continue;
+      cand[k] = 1;
+   }
+   for (k = 0; k < 64 && n < max; k++)
+   {
+      int stack[64], sp = 0, j, pal, pr = -1, mixed = 0, w, hh, i;
+      fx_grp *g;
+      uint64_t hs;
+      if (!cand[k] || used[k]) continue;
+      g = &out[n]; memset(g, 0, sizeof *g);
+      pal = f->sprcol[k] & 15;
+      g->pal = pal; g->x0 = g->y0 = 9999; g->x1 = g->y1 = -9999; g->first = 64;
+      stack[sp++] = k; used[k] = 1;
+      while (sp)
+      {
+         int a = stack[--sp], p2 = (ld16(f->spr + a * 4) & 0x1800) >> 11;
+         g->m[a] = 1;
+         if (pr < 0) pr = p2; else if (pr != p2) mixed = 1;
+         if (a < g->first) g->first = a;
+         if (px[a] < g->x0) g->x0 = px[a];
+         if (py[a] < g->y0) g->y0 = py[a];
+         if (px[a] + 8 > g->x1) g->x1 = px[a] + 8;
+         if (py[a] + 8 > g->y1) g->y1 = py[a] + 8;
+         for (j = 0; j < 64; j++)
+            if (cand[j] && !used[j] && (f->sprcol[j] & 15) == pal && abs(px[j] - px[a]) <= 9 && abs(py[j] - py[a]) <= 9)
+            { used[j] = 1; stack[sp++] = j; }
+      }
+      g->depth = mixed ? -1 : pr << 1;
+      w = g->x1 - g->x0; hh = g->y1 - g->y0;
+      if (!mixed && w > 0 && hh > 0 && w <= ID_W && hh <= ID_H)
+      {  /* 지문: FNV-1a(폭·높이·화소 색 번호) — 오프라인 캐시 만들기(fxharvest.py)와 같게 */
+         fx_draw_grp(f, g, idx, 0);
+         hs = 1469598103934665603ULL;
+         hs = (hs ^ (uint64_t)(w & 0xff)) * 1099511628211ULL;
+         hs = (hs ^ (uint64_t)(hh & 0xff)) * 1099511628211ULL;
+         for (i = 0; i < w * hh; i++) hs = (hs ^ (uint64_t)idx[i]) * 1099511628211ULL;
+         g->sig = hs | 1;
+      }
+      n++;
+   }
+   return n;
+}
+static const fx_grp *fx_match(const fx_grp *a, const fx_grp *arr, int n)
+{
+   int i, best = 41, cx = a->x0 + a->x1, cy = a->y0 + a->y1;
+   const fx_grp *r = 0;
+   for (i = 0; i < n; i++)
+   {
+      int d;
+      if (arr[i].pal != a->pal) continue;
+      d = (abs(arr[i].x0 + arr[i].x1 - cx) + abs(arr[i].y0 + arr[i].y1 - cy)) / 2;
+      if (d < best) { best = d; r = &arr[i]; }
+   }
+   return r;
+}
+static void fx_pic(const ss2fg_frame *f, const fx_grp *g, id_pose *P)
+{
+   P->sig = g->sig; P->ox = g->x0; P->oy = g->y0; P->w = g->x1 - g->x0; P->h = g->y1 - g->y0;
+   P->depth = (uint8_t)g->depth; P->first = (uint8_t)g->first;
