+/* 출력 칸 slot 의 이펙트 사이 그림 계획 — 바뀌기 직전 2 프레임에 ¼·½·¾(몸 캐시의 «마지막 2 프레임»과 같은 셈) */
+static int fx_plan(const ss2fg_frame *f0, const ss2fg_frame *f1, const ss2fg_frame *f2, unsigned realn, int h, int slot)
+{
+   int i, n = 0;
+   fx_reset_slot(slot);
+   if (!mc_on || !mc_f || !f0 || !f1) return 0;
+   if (fx_g_realn != realn)
+   {
+      fx_gn[0] = fx_fp ? fx_groups(fx_fp, fx_g[0], FXG_MAX) : 0;
+      fx_gn[1] = fx_groups(f0, fx_g[1], FXG_MAX);
+      fx_gn[2] = fx_groups(f1, fx_g[2], FXG_MAX);
+      fx_gn[3] = f2 ? fx_groups(f2, fx_g[3], FXG_MAX) : 0;
+      fx_g_realn = realn;
+   }
+   for (i = 0; i < fx_gn[1] && n < FX_N; i++)
+   {
+      const fx_grp *a = &fx_g[1][i], *b = 0, *m1, *pv;
+      const ss2fg_frame *fk;
+      int K = 0, L, num, ti, dx, dy;
+      mc_ent *e;
+      if (!a->sig) continue;
+      m1 = fx_match(a, fx_g[2], fx_gn[2]);
+      if (!m1) continue;
+      if (m1->sig != a->sig) { K = 1; b = m1; }
+      else if (f2)
+      {
+         const fx_grp *m2 = fx_match(m1, fx_g[3], fx_gn[3]);
+         if (m2 && m2->sig != a->sig) { K = 2; b = m2; }
+      }
+      if (!K || !b->sig || b->depth != a->depth) continue;
+      if (slot == 0) fx_st[0]++;
+      pv = fx_match(a, fx_g[0], fx_gn[0]);
+      L = (pv && pv->sig == a->sig) ? 2 : K;                 /* A 가 보이는 프레임 수(바뀔 때까지, 2 까지) */
+      if (L > 2) L = 2;
+      num = 2 * L - (2 * K - h);
+      if (num <= 0) continue;
+      ti = L == 2 ? num - 1 : 1;
+      if (ti < 0 || ti > 2) continue;
+      e = mc_get(a->sig, b->sig);
+      if (!e) continue;
+      if (slot == 0) fx_st[1]++;
+      if (e->aw != a->x1 - a->x0 || e->ah != a->y1 - a->y0 || e->bw != b->x1 - b->x0 || e->bh != b->y1 - b->y0) continue;
+      dx = (b->x0 - a->x0) - e->bdx; dy = (b->y0 - a->y0) - e->bdy;
+      if (dx < -4 || dx > 4 || dy < -4 || dy > 4) continue;
+      fk = K == 1 ? f1 : f2;
+      fx_pic(f0, a, &fx_pa[slot][n]);
+      fx_pic(fk, b, &fx_pb[slot][n]);
+      {
+         fx_req_t *rq = &fx_rq[slot][n];
+         rq->on = 1; rq->e = e; rq->ti = ti;
+         rq->gx = a->x0 + e->cx; rq->gy = a->y0 + e->cy; rq->gw = e->w; rq->gh = e->h;
+         rq->sx4 = (ti + 1) * dx; rq->sy4 = (ti + 1) * dy;
+         rq->depth = a->depth; rq->first = a->first;
+         memcpy(rq->m, a->m, 64);
+      }
+      if (slot == 0) fx_st[2]++;
+      n++;
+   }
+   return n > 0;
+}
