       if (fk && mc_top_left(fk, p, &bx0, &by0)) { rbx = bx0 - ax0; rby = by0 - ay0; }
       else { rbx = B->ox - A->ox; rby = B->oy - A->oy; }
       dx = rbx - e->bdx; dy = rby - e->bdy;
-      if (dx < -4 || dx > 4 || dy < -4 || dy > 4) { mc_stats[3]++; return 0; }
+      /* zzzz_fg_landing: 뒤 포즈를 미리 돌린 프레임(fk)에서 실제로 봤으면 가로 6·세로 12 까지 메운다 — 4 를 넘는 차의 대부분은
+         같은 바뀜이 다른 높이·자리에서 나온 것(착지: 공중 포즈 → 착지 포즈가 모은 판보다 11px 낮게 등 — 봇 33판 «far» 의 절반)이라
+         t 만큼 나눠 밀면 실제 움직임 그대로다. 실제로 못 본 뒤 포즈(기억한 자리)는 예전처럼 4. 밀어서 틀이 조각 버퍼를 넘으면 툭 */
+      if (fk ? (dx < -6 || dx > 6 || dy < -12 || dy > 12
+                || (e->w + (3 * abs(dx) + 3) / 4 + 2) * (e->h + (3 * abs(dy) + 3) / 4 + 2) > ID_W * ID_H)
+             : (dx < -4 || dx > 4 || dy < -4 || dy > 4)) { mc_stats[3]++; return 0; }
       rq->gx = ax0 + e->cx; rq->gy = ay0 + e->cy;
       rq->sx4 = (ti + 1) * dx; rq->sy4 = (ti + 1) * dy;   /* t = (ti+1)/4 → 4배 화소로 t·차·4 */
