@@ -596,3 +628,47 @@ int int_timer_StateAction(void *data, int load, int data_only)
 
    return 1;
 }
+
+/* ── 앱 방 코어 패치 zzzzzzzzzzzzz_snd_only: 메인 CPU(TLCS-900h)를 세운 채 소리 CPU 박자만 ──
+   앱의 덧판 메뉴가 게임을 세운 동안(쉼·서랍·대기) 원작 PAUSE 처럼 배경음을 잇는다. 타이머 2·3(타이머 3 = Z80 IRQ 4.08ms)을
+   «그림자» 사본으로 센다 — 진짜 타이머·인터럽트·마이크로 DMA·그림은 한 비트도 안 바뀐다(세운 동안 저장한 상태 = 세운 순간의 메인 CPU).
+   진짜 타이머가 바뀌었으면(실제 프레임·상태 불러오기·리셋) 그림자를 거기서 다시 잡는다. 소리 시각은 늘 보통 빠르기(snd_div 무관) */
+static uint32_t so_clk[2], so_ref_clk[2];
+static uint8_t so_tm[2], so_ref_tm[2];
+static int so_valid = 0;
+unsigned ngp_sndonly_resync = 0;
+void ngp_sndonly_ticks(int cputicks)
+{
+   bool t2 = false;
+   if (!so_valid || so_ref_clk[0] != timer_clock[2] || so_ref_clk[1] != timer_clock[3] || so_ref_tm[0] != timer[2] || so_ref_tm[1] != timer[3])
+   {
+      so_clk[0] = so_ref_clk[0] = timer_clock[2]; so_clk[1] = so_ref_clk[1] = timer_clock[3];
+      so_tm[0] = so_ref_tm[0] = timer[2]; so_tm[1] = so_ref_tm[1] = timer[3];
+      so_valid = 1; ngp_sndonly_resync++;
+   }
+   ngpc_soundTS += cputicks;
+   so_clk[0] += cputicks;
+   so_clk[1] += cputicks;
+   if ((TRUN & 0x04))
+   {
+      switch (T23MOD & 0x03)
+      {
+         case 1: while (so_clk[0] >= TIMER_T1_RATE / 2) { so_tm[0]++; so_clk[0] -= TIMER_T1_RATE / 2; } break;
+         case 2: while (so_clk[0] >= TIMER_T4_RATE) { so_tm[0]++; so_clk[0] -= TIMER_T4_RATE; } break;
+         case 3: while (so_clk[0] >= TIMER_T16_RATE) { so_tm[0]++; so_clk[0] -= TIMER_T16_RATE; } break;
+         default: break;
+      }
+      if (timer_threshold[2] && so_tm[0] >= timer_threshold[2]) { so_tm[0] = 0; t2 = true; }
+   }
+   if ((TRUN & 0x08))
+   {
+      switch ((T23MOD & 0x0C) >> 2)
+      {
+         case 0: if (t2) { so_tm[1] += t2; so_clk[1] = 0; } break;
+         case 1: while (so_clk[1] >= TIMER_T1_RATE) { so_tm[1]++; so_clk[1] -= TIMER_T1_RATE; } break;
+         case 2: while (so_clk[1] >= TIMER_T16_RATE) { so_tm[1]++; so_clk[1] -= TIMER_T16_RATE; } break;
+         case 3: while (so_clk[1] >= TIMER_T256_RATE) { so_tm[1]++; so_clk[1] -= TIMER_T256_RATE; } break;
+      }
+      if (timer_threshold[3] && so_tm[1] >= timer_threshold[3]) { so_tm[1] = 0; Z80_irq(); }
+   }
+}
