@@ -135,7 +136,7 @@ static void Emulate(EmulateSpecStruct *espec, int16_t *sound_buf)
             break;
          }
 
-         z80_runtime -= z80rantime << 1;
+         z80_runtime -= (z80rantime << 1) * ngp_snd_div;   /* snd_only: d > 1 이면 Z80 도 1/d 빠르기(나머지는 z80_runtime — 상태 안) */
 
       }
    }while(!MeowMeow);
@@ -2334,3 +2335,59 @@ void MDFN_MakeFName(uint8_t type, char *s, size_t len,
 void retro_ngp_fx_stats(int *out8) { ss2fg_fx_stats(out8); }
 /* debug export: 포즈 섞기 계기 4칸 (시험 하네스) */
 void retro_ngp_pose_stats(int *out4) { ss2fg_pose_stats(out4); }
+
+/* ── 앱 방 코어 패치 zzzzzzzzzzzzz_snd_only ──────────────────────────────────────────────────────────────
+   retro_ngp_sndonly_run(n): 메인 CPU(TLCS-900h)·그림·입력은 세운 채 소리 CPU(Z80)와 소리 칩(T6W28)만 retro_run n 번 몫 돌려 소리를
+   audio_batch 콜백으로 낸다(앱: 덧판 메뉴가 게임을 세운 동안 — 원작 PAUSE 처럼 배경음이 이어진다). 한 번 = retro_run 한 번의 시간
+   (보통 한 프레임 515×199 틱 · 2배 출력(120Hz) 중엔 반 프레임씩 — 앱은 retro_run 과 같은 박자로 부른다). 메인 CPU 의 램·레지스터·
+   타이머·인터럽트는 그대로 — 바뀌는 것은 Z80(레지스터·Z80 램 0x7000~·CommByte·z80_runtime)과 소리 칩뿐. 해설 음성은 이어서 섞는다.
+   retro_ngp_snd_div(d): 소리(Z80 박자·IRQ·소리 시각)만 1/d — 앱이 4배속 자동 진행 동안 4 로(곡이 보통 빠르기 · 음높이 그대로).
+   retro_ngp_sndonly_info(v[6]): 시험용 — 돈 횟수 · 받아 둔 Z80→메인 인터럽트 · d · 그림자 타이머 다시 잡은 횟수 · 지금 2배 출력 · 반 프레임 차례 */
+extern void ngp_sndonly_ticks(int cputicks);
+extern void ngp_snd_div_set(int d);
+extern int ngp_sndonly_on, ngp_sndonly_int;
+extern unsigned ngp_sndonly_ints, ngp_sndonly_resync;
+#define SO_FRAME_TICKS (515 * 199)
+#define SO_STEP        12                /* 틱 — TLCS 명령 하나 크기쯤(타이머·Z80 IRQ 위치가 이만큼 안에서 맞는다) */
+static int16_t  so_buf[0x4000];
+static int      so_half = 0;
+static unsigned so_runs = 0;
+void retro_ngp_sndonly_run(int frames)
+{
+   int f;
+   if (!audio_batch_cb) return;
+   for (f = 0; f < frames; f++)
+   {
+      int32_t ticks = SO_FRAME_TICKS, done = 0, n, total = 0;
+      if (fg_active) { ticks = so_half ? ticks - ticks / 2 : ticks / 2; so_half ^= 1; }
+      else so_half = 0;
+      ngp_sndonly_on = 1;
+      ngpc_soundTS = 0;
+      rr_sound_buf = so_buf;                          /* snd_noise(«배경음만»): 이 버퍼의 잡음 칸을 앱이 찾게 */
+      MDFNNGPCSOUND_NoiseTarget(so_buf);
+      while (done < ticks)
+      {
+         int step = ticks - done < SO_STEP ? (int)(ticks - done) : SO_STEP;
+         ngp_sndonly_ticks(step);
+         z80_runtime += step;
+         while (z80_runtime > 0)
+         {
+            int r = Z80_RunOP();
+            if (r < 0) { z80_runtime = 0; break; }
+            z80_runtime -= r << 1;
+         }
+         done += step;
+      }
+      ngp_sndonly_on = 0;
+      n = MDFNNGPCSOUND_Flush(so_buf, (int32_t)(sizeof(so_buf) / 4));
+      ss2voice_mix(so_buf, n);
+      so_runs++;
+      while (total < n) total += audio_batch_cb(so_buf + total * 2, n - total);
+   }
+}
+void retro_ngp_snd_div(int div) { ngp_snd_div_set(div); }
+void retro_ngp_sndonly_info(int *v)
+{
+   v[0] = (int)so_runs; v[1] = (int)ngp_sndonly_ints; v[2] = ngp_snd_div; v[3] = (int)ngp_sndonly_resync;
+   v[4] = fg_active; v[5] = so_half;
+}
