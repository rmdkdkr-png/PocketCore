+/* 앱 방 코어 패치 zzzzzzzzzzzzz_snd_only — 소리만 1/d 빠르기(retro_ngp_snd_div: 앱의 4배속 자동 진행에서 곡을 보통 빠르기로).
+   d 가 1 이면 원래 그대로. d > 1: 소리 시각(ngpc_soundTS)·Z80 IRQ(타이머 3)를 d 번에 한 번만, Z80 명령 값은 d 배(libretro.c Emulate).
+   나머지 셈은 상태 밖이라 숨은 프레임(프레임 생성·런어헤드 — ngp_fg_mute)은 따로 세어 실제 프레임의 셈을 건드리지 않는다
+   (숨은 프레임은 끝나면 상태를 되돌린다 — 따로 센 것은 버린다) */
+extern int ngp_fg_mute;
+int ngp_snd_div = 1;
+static int snd_div_ts[2], snd_div_irq[2];    /* [0] 실제 프레임 · [1] 숨은 프레임 */
+void ngp_snd_div_set(int d)
+{
+   if (d < 1) d = 1;
+   if (d > 8) d = 8;
+   if (d != ngp_snd_div) { snd_div_ts[0] = snd_div_ts[1] = 0; snd_div_irq[0] = snd_div_irq[1] = 0; }
+   ngp_snd_div = d;
+}
+/* snd_only: 메인 CPU 를 세운 채 소리 CPU 만 돌리는 동안 Z80 이 메인 CPU 에 건 인터럽트(0xC000) — 세운 CPU·마이크로 DMA 를
+   건드리지 않게 받아 두었다가 다음 실제 프레임 첫 틱에 건다(사무쇼2 는 안 쓴다 — 시험에서 0 번) */
+int ngp_sndonly_on = 0, ngp_sndonly_int = 0;
+unsigned ngp_sndonly_ints = 0;
+
 bool updateTimers(void *data, int cputicks)
 {
    bool ret = false;
 
-   ngpc_soundTS += cputicks;
+   if (ngp_sndonly_int && !ngp_fg_mute) { ngp_sndonly_int = 0; TestIntHDMA(6, 0x0C); }
+   if (ngp_snd_div <= 1) ngpc_soundTS += cputicks;
+   else
+   {
+      int h = ngp_fg_mute ? 1 : 0;
+      snd_div_ts[h] += cputicks;
+      ngpc_soundTS += snd_div_ts[h] / ngp_snd_div;
+      snd_div_ts[h] %= ngp_snd_div;
+   }
 
    /* increment H-INT timer */
    timer_hint += cputicks;
@@ -480,7 +507,12 @@ bool updateTimers(void *data, int cputicks)
       {
          timer[3] = 0;
 
-         Z80_irq();
+         if (ngp_snd_div <= 1) Z80_irq();
+         else
+         {
+            int h = ngp_fg_mute ? 1 : 0;
+            if (++snd_div_irq[h] >= ngp_snd_div) { snd_div_irq[h] = 0; Z80_irq(); }
