+/* 겉모습 투표 — 무리(gstart..g-1)의 각 조각이 to 에서 «겉모습·우선순위·팔레트가 같은 조각»을 찾아
+   그 거리로 표를 던진다(슬롯 번호 무관). 한 조각이 여러 곳과 맞으면 표를 나눈다. 뚜렷한 1등이 있으면
+   그게 몸의 이동(0 이면 제자리) → 1, 아니면 0 (판단 보류 → 슬롯 번호 규칙으로). */
+#define FG_VOTE_UNIT 12
+static int look_vote(const ss2fg_frame *base, const ss2fg_frame *to, const uint64_t *lb, const uint64_t *lt,
+                     int gstart, int g, int *vx, int *vy)
+{
+   const ss2fg_regs *rb = &base->line[0], *rt = &to->line[0];
+   int cdx[256], cdy[256], cw[256], nc = 0, npc = 0, k, j, c;
+   int best = -1, second = 0;
+   for (k = gstart; k < g; k++)
+   {
+      int dup = 0, mj[4], mdx[4], mdy[4], m = 0, bx, by;
+      uint16_t wb = ld16(base->spr + k * 4);
+      if (!lb[k]) continue;
+      for (j = gstart; j < g; j++) if (lb[j] == lb[k]) dup++;
+      if (dup > 2) continue;                                   /* 흔한 무늬(칠한 면)는 아무 데나 맞는다 */
+      npc++;
+      bx = wrapx(base->ax[k] + rb->spx); by = wrapc(base->ay[k] + rb->spy);
+      for (j = 0; j < 64 && m <= 4; j++)
+      {
+         uint16_t wt = ld16(to->spr + j * 4);
+         int dx, dy;
+         if (lt[j] != lb[k] || (wt & 0x1800) != (wb & 0x1800) || to->sprcol[j] != base->sprcol[k]) continue;
+         dx = wrapx(to->ax[j] + rt->spx) - bx; dy = wrapc(to->ay[j] + rt->spy) - by;
+         if (dx > SS2FG_SPR_MAX_STEP || dx < -SS2FG_SPR_MAX_STEP || dy > SS2FG_SPR_MAX_STEP || dy < -SS2FG_SPR_MAX_STEP) continue;
+         if (m < 4) { mj[m] = j; mdx[m] = dx; mdy[m] = dy; }
+         m++;
+      }
+      if (m == 0 || m > 4) continue;                           /* 바뀐 조각 / 너무 흔한 조각 */
+      for (j = 0; j < m; j++)
+      {
+         for (c = 0; c < nc; c++) if (cdx[c] == mdx[j] && cdy[c] == mdy[j]) break;
+         if (c == nc) { if (nc == 256) continue; cdx[nc] = mdx[j]; cdy[nc] = mdy[j]; cw[nc] = 0; nc++; }
+         cw[c] += FG_VOTE_UNIT / m;
+      }
+      (void)mj;
+   }
+   for (c = 0; c < nc; c++)
+      if (best < 0 || cw[c] > cw[best]) best = c;
+   if (best < 0) return 0;
+   for (c = 0; c < nc; c++)
+      if (c != best && cw[c] > second) second = cw[c];
+   if (cw[best] < 2 * FG_VOTE_UNIT) return 0;                  /* 두 조각 몫은 맞아야 */
+   if (cw[best] * 10 < npc * FG_VOTE_UNIT * 3) return 0;       /* 겉모습 있는 조각의 30% 이상 */
+   if (cw[best] < 2 * second) return 0;                        /* 뚜렷한 1등 */
+   *vx = cdx[best]; *vy = cdy[best];
+   return 1;
+}
