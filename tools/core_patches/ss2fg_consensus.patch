+/* 제자리 겹침이 벡터 겹침보다 많으면 «배치만 바뀜». 같을 때는 벡터가 타일 간격 쪽(4px 이상)일 때만 —
+   번호 밀림은 늘 ±8 근처로 나오고, 1~2px 짜리 동점은 실제로 조금 움직인 몸이라 보간을 살린다. */
+static int layout_only(const ss2fg_frame *base, const ss2fg_frame *to, int gstart, int g, int vx, int vy)
+{
+   int o0, ov;
+   if (!vx && !vy) return 0;
+   o0 = grp_overlap(base, to, gstart, g, 0, 0);
+   ov = grp_overlap(base, to, gstart, g, vx, vy);
+   if (o0 > ov) return 1;
+   return o0 == ov && (vx >= 4 || vx <= -4 || vy >= 4 || vy <= -4);
+}
