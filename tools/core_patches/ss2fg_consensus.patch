+/* 무리 벡터 검증용 — base 무리의 조각 중, 그 자리 + (vx,vy) 에 to 의 «같은 우선순위·팔레트» 조각이
+   (슬롯 번호와 상관없이) 놓여 있는 개수. 슬롯 번호로 짝지은 벡터가 진짜 이동인지, 조각 하나가 끼어들어
+   번호가 한 칸씩 밀린 것(배치는 그대로)인지 가른다. */
+static int grp_overlap(const ss2fg_frame *base, const ss2fg_frame *to, int gstart, int g, int vx, int vy)
+{
+   const ss2fg_regs *rb = &base->line[0], *rt = &to->line[0];
+   int k, j, c = 0;
+   for (k = gstart; k < g; k++)
+   {
+      uint16_t wb = ld16(base->spr + k * 4);
+      int bx, by;
+      if (!(wb & 0x1800)) continue;
+      bx = wrapx(base->ax[k] + rb->spx) + vx; by = wrapc(base->ay[k] + rb->spy) + vy;
+      for (j = 0; j < 64; j++)
+      {
+         uint16_t wt = ld16(to->spr + j * 4);
+         if (!(wt & 0x1800) || (wt & 0x1800) != (wb & 0x1800) || to->sprcol[j] != base->sprcol[k]) continue;
+         if (wrapx(to->ax[j] + rt->spx) == bx && wrapc(to->ay[j] + rt->spy) == by) { c++; break; }
+      }
+   }
+   return c;
+}
