+/* zzzzzzzzz_fg_walkcycle: 걸음 표에서 포즈 P — 없으면 0 */
+static const mc_walk_t *mc_walk_find(uint64_t sg)
+{
+   int lo = 0, hi = (int)mc_wn - 1;
+   while (lo <= hi)
+   {
+      int mid = (lo + hi) >> 1;
+      if (mc_wk[mid].sig == sg) return mc_wk[mid].n ? &mc_wk[mid] : 0;
+      if (mc_wk[mid].sig < sg) lo = mid + 1; else hi = mid - 1;
+   }
+   return 0;
+}
