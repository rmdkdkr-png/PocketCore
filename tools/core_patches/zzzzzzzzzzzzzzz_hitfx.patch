+/* ── 먹 베기 띠(3) — draft_c 를 C 로. 4배 텍셀 칸(미리 곱한 RGBA)에 띠·빛줄·글자(+ 잔상)·낙관을 짜 맞춘 뒤 pm_draw ── */
+#define INK_CW 480
+#define INK_CH 140
+static uint8_t ink_cv[INK_CW * INK_CH * 4];
+static uint8_t *ink_part[4][3];         /* 풀어 둔 조각: 띠 A8 · 글자 A8 · 낙관 RGBA(곧은) */
+
+static void unpack_bytes(const uint8_t *p, uint8_t *out, int n)
+{
+   int i = 0;
+   while (i < n) {
+      int b = *p++;
+      if (b < 128) { int v = *p++; for (int k = 0; k <= b && i < n; k++) out[i++] = (uint8_t)v; }
+      else for (int k = 0; k < b - 127 && i < n; k++) out[i++] = *p++;
+   }
+}
+
+static int ink_ready(int kind)
+{
+   if (ink_part[kind][0]) return 1;
+   for (int j = 0; j < 3; j++) {
+      const sli_img *im = &SLI_IMG[kind * 3 + j];
+      int n = im->w * im->h * (j == 2 ? 4 : 1);
+      uint8_t *b = (uint8_t *)malloc((size_t)n);
+      if (!b) return 0;
+      unpack_bytes(SLI_DATA + im->off, b, n);
+      ink_part[kind][j] = b;
+   }
+   return 1;
+}
+
+static double ease_out(double x) { if (x < 0) x = 0; if (x > 1) x = 1; return 1 - (1 - x) * (1 - x) * (1 - x); }
+static double ease_out_back(double x, double k) { if (x < 0) x = 0; if (x > 1) x = 1; return 1 + (k + 1) * (x - 1) * (x - 1) * (x - 1) + k * (x - 1) * (x - 1); }
+
+/* 칸 (x, y) 에 미리 곱한 (r, g, b, a) 를 덮기 */
+static void cv_over(int x, int y, int r, int g, int b, int a)
+{
+   if ((unsigned)x >= INK_CW || (unsigned)y >= INK_CH || a <= 0) return;
+   uint8_t *d = ink_cv + ((size_t)y * INK_CW + (size_t)x) * 4;
+   int na = 255 - a;
+   d[0] = (uint8_t)(r + (d[0] * na + 127) / 255); d[1] = (uint8_t)(g + (d[1] * na + 127) / 255);
+   d[2] = (uint8_t)(b + (d[2] * na + 127) / 255); d[3] = (uint8_t)(a + (d[3] * na + 127) / 255);
+}
