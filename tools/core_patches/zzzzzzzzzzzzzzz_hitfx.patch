+/* ── 195 라벨 ── */
+static int floordiv(int a, int b) { return a >= 0 ? a / b : -((-a + b - 1) / b); }
+
+/* 게임 화소 (gx, gy) 하나에 곧은 알파 RGBA(0xAABBGGRR) — sub×sub 화소, 게임 사각형 밖은 안 그림 */
+static void put_rgba(const dctx *c, int gx, int gy, uint32_t rgba)
+{
+   int a = (int)(rgba >> 24);
+   if (!a || (unsigned)gx >= 160u || (unsigned)gy >= 152u) return;
+   int r = (int)(rgba & 255), g = (int)((rgba >> 8) & 255), b = (int)((rgba >> 16) & 255);
+   for (int ty = 0; ty < c->sub; ty++) {
+      size_t o = (size_t)(c->oy + gy * c->sub + ty) * (size_t)c->pitch + (size_t)(c->ox + gx * c->sub);
+      for (int tx = 0; tx < c->sub; tx++) {
+         uint16_t *d = &c->buf[o + tx];
+         int dr = r, dg = g, db = b;
+         if (a < 255) {
+            int er = (((*d >> 11) & 31) * 255 + 15) / 31, eg = (((*d >> 5) & 63) * 255 + 31) / 63, eb = ((*d & 31) * 255 + 15) / 31;
+            dr = (r * a + er * (255 - a) + 127) / 255; dg = (g * a + eg * (255 - a) + 127) / 255; db = (b * a + eb * (255 - a) + 127) / 255;
+         }
+         *d = (uint16_t)(((dr * 31 + 127) / 255) << 11 | ((dg * 63 + 127) / 255) << 5 | ((db * 31 + 127) / 255));
+         if (c->ph) c->ph[o + tx] = 0;
+      }
+   }
+}
