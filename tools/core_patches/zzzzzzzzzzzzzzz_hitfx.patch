@@ -0,0 +1,205 @@
+/* ss2hit — 설명은 ss2hit.h. callout.c·hitflash.c(앱 Legacito 원본 그대로)를 코어의 프레임·그림·팔레트에 잇는다.
+ *
+ * 시계: 라벨 움직임은 진짜 프레임 수 / 60 초(앱은 vsync 시각 — 60Hz 게임에선 같다). 120Hz 합성 호출은 반 프레임 뒤.
+ * 판정: 런어헤드면 보여 줄 프레임(N + ra)의 램 사본으로(앱 187 — 실제 램이면 보이는 맞음보다 ra 프레임 늦었다). 앞선 수가 바뀌면 한 번 판정 없이.
+ * 몸 번쩍: 실제 팔레트 램에 흰색 + gfx.c 번쩍 층(게임이 맞은 지 2 프레임 뒤 몸 팔레트를 다시 쓰는 것도 흰색으로 — 런어헤드에서도 보이게).
+ * 그림: 이펙트는 게임 화소(4배 그림이면 4×4, 쪽지 0) · 라벨은 4배 아틀라스(앱 GL 과 같은 그림) — 4배 그림엔 텍셀 그대로,
+ *       1배 그림엔 4×4 텍셀 평균(넓이 거르기). 놀이 칸·게임 사각형 밖은 안 그린다.
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "ss2hit.h"
+#include "callout.h"
+#include "hitflash.h"
+
+void ngpgfx_flashlayer(int pal, const uint16_t *from, const uint16_t *to);   /* mednafen/ngp/gfx.c */
+
+static unsigned h_rf;                 /* 진짜 프레임 수(라벨 시계) */
+static int      h_lead = -1;          /* 지난 판정의 앞선 프레임 수 */
+static int      h_flash_n;            /* 낸 번쩍 수(시험) */
+static int      h_undo[2];            /* 상태 저장 동안 되돌린 쪽 */
+static uint16_t h_was[2][3];
+
+static void sync_layer(void)
+{
+   for (int s = 0; s < 2; s++) {
+      uint16_t from[3], to[3];
+      if (hitflash_remap(s, from, to)) ngpgfx_flashlayer(s ? 5 : 0, from, to);
+      else ngpgfx_flashlayer(s ? 5 : 0, NULL, NULL);
+   }
+}
+
+void ss2hit_options(int callout, int fx, int flash)
+{
+   callout_enable(callout);
+   callout_fx_mode(fx ? FXM_ON : FXM_OFF);
+   callout_flash_enable(flash);
+}
+
+void ss2hit_frame(const uint8_t *ram, const uint8_t *spal, int lead, uint8_t *pal)
+{
+   int fs;
+   h_rf++;
+   hitflash_tick(pal);                 /* 다 됐으면(아직 우리 흰색이면) 되돌린다 — 게임이 다른 색을 썼으면 게임 것 그대로 */
+   sync_layer();
+   if (!ram) return;
+   if (lead != h_lead) { callout_resync(); h_lead = lead; }
+   callout_fx_pal(spal ? spal : pal);  /* 칼 궤적 색도 보이는 프레임 것 */
+   callout_tick(ram, 16384, h_rf / 60.0);
+   fs = callout_flash_take();
+   if (fs && pal) { hitflash_start(pal, fs - 1); sync_layer(); h_flash_n++; }
+}
+
+void ss2hit_reset(void)
+{
+   callout_reset();
+   hitflash_forget();
+   ngpgfx_flashlayer(-1, NULL, NULL);
+   callout_fx_pal(NULL);
+   h_lead = -1;
+   h_undo[0] = h_undo[1] = 0;
+}
+
+static void pal_rw(uint8_t *pal, int p, uint16_t c[3], int wr)
+{
+   for (int j = 0; j < 3; j++) {
+      uint8_t *e = pal + p * 8 + (j + 1) * 2;
+      if (wr) { e[0] = (uint8_t)c[j]; e[1] = (uint8_t)(c[j] >> 8); }
+      else c[j] = (uint16_t)(e[0] | (e[1] << 8));
+   }
+}
+
+void ss2hit_save_begin(uint8_t *pal)
+{
+   for (int s = 0; s < 2; s++) {
+      uint16_t save[3], put[3], raw[3];
+      h_undo[s] = 0;
+      if (!pal || !hitflash_raw(s, save, put)) continue;
+      pal_rw(pal, s ? 5 : 0, raw, 0);
+      if (((raw[0] ^ put[0]) | (raw[1] ^ put[1]) | (raw[2] ^ put[2])) & 0xFFF) continue;   /* 지금 우리 흰색이 아님 */
+      memcpy(h_was[s], raw, sizeof raw);
+      pal_rw(pal, s ? 5 : 0, save, 1);
+      h_undo[s] = 1;
+   }
+}
+
+void ss2hit_save_end(uint8_t *pal)
+{
+   for (int s = 0; s < 2; s++) {
+      if (h_undo[s] && pal) pal_rw(pal, s ? 5 : 0, h_was[s], 1);
+      h_undo[s] = 0;
+   }
+}
+
+void ss2hit_debug(int v[11])
+{
+   callout_stats(v);
+   v[8] = callout_fx_count();
+   v[9] = hitflash_active();
+   v[10] = h_flash_n;
+}
+
+/* ── 그리기 ── */
+typedef struct { uint16_t *buf; int pitch, ox, oy, sub; uint8_t *ph; const uint32_t *cmap; } dctx;
+
+static void fx_put(void *ctx, int gx, int gy, uint16_t c12)
+{
+   const dctx *c = (const dctx *)ctx;
+   uint16_t v = (uint16_t)c->cmap[c12 & 0xFFF];
+   for (int ty = 0; ty < c->sub; ty++) {
+      size_t o = (size_t)(c->oy + gy * c->sub + ty) * (size_t)c->pitch + (size_t)(c->ox + gx * c->sub);
+      for (int tx = 0; tx < c->sub; tx++) {
+         c->buf[o + tx] = v;
+         if (c->ph) c->ph[o + tx] = 0;   /* 이펙트 화소는 게임 화소 모눈에 맞춰 그렸다 */
+      }
+   }
+}
+
+static uint8_t *a_pm;                  /* 라벨 아틀라스 — 미리 곱한 알파 RGBA(4배) */
+static int a_w, a_h;
+
+static int atlas_ready(void)
+{
+   const uint8_t *rgba; int w, h;
+   if (a_pm) return 1;
+   if (!callout_atlas(&rgba, &w, &h, NULL, NULL) || !rgba || w <= 0 || h <= 0) return 0;
+   a_pm = (uint8_t *)malloc((size_t)w * h * 4);
+   if (!a_pm) return 0;
+   for (int i = 0; i < w * h; i++) {
+      unsigned a = rgba[i * 4 + 3];
+      a_pm[i * 4 + 0] = (uint8_t)((rgba[i * 4 + 0] * a + 127) / 255);
+      a_pm[i * 4 + 1] = (uint8_t)((rgba[i * 4 + 1] * a + 127) / 255);
+      a_pm[i * 4 + 2] = (uint8_t)((rgba[i * 4 + 2] * a + 127) / 255);
+      a_pm[i * 4 + 3] = (uint8_t)a;
+   }
+   a_w = w; a_h = h;
+   return 1;
+}
+
+static int floordiv(int a, int b) { return a >= 0 ? a / b : -((-a + b - 1) / b); }
+
+/* 라벨 하나 — 게임 사각형 기준 텍셀(게임 화소당 4) 자리 X0·Y0 에 아틀라스 사각형 tr. 화소 하나 = g×g 텍셀 평균(g = 4 / sub) */
+static void label_draw(const dctx *c, int X0, int Y0, const int tr[4], int ia, int ifl)
+{
+   int g = 4 / c->sub, gg = g * g;
+   int px0 = floordiv(X0, g), px1 = floordiv(X0 + tr[2] - 1, g);
+   int py0 = floordiv(Y0, g), py1 = floordiv(Y0 + tr[3] - 1, g);
+   int W = 160 * c->sub, H = 152 * c->sub;
+   if (px0 < 0) px0 = 0;
+   if (py0 < 0) py0 = 0;
+   if (px1 > W - 1) px1 = W - 1;
+   if (py1 > H - 1) py1 = H - 1;
+   for (int py = py0; py <= py1; py++) {
+      uint16_t *row = c->buf + (size_t)(c->oy + py) * (size_t)c->pitch + c->ox;
+      uint8_t *prow = c->ph ? c->ph + (size_t)(c->oy + py) * (size_t)c->pitch + c->ox : NULL;
+      for (int px = px0; px <= px1; px++) {
+         int sr = 0, sg = 0, sb = 0, sa = 0;
+         for (int j = 0; j < g; j++) {
+            int ty = py * g + j - Y0;
+            if (ty < 0 || ty >= tr[3]) continue;
+            const uint8_t *srow = a_pm + ((size_t)(tr[1] + ty) * (size_t)a_w + (size_t)tr[0]) * 4;
+            for (int i = 0; i < g; i++) {
+               int tx = px * g + i - X0;
+               if (tx < 0 || tx >= tr[2]) continue;
+               const uint8_t *s = srow + tx * 4;
+               sr += s[0]; sg += s[1]; sb += s[2]; sa += s[3];
+            }
+         }
+         if (!sa) continue;
+         int r = (sr + gg / 2) / gg, gr = (sg + gg / 2) / gg, b = (sb + gg / 2) / gg, a = (sa + gg / 2) / gg;
+         if (!a) continue;
+         if (ifl) { r += ((a - r) * ifl) >> 8; gr += ((a - gr) * ifl) >> 8; b += ((a - b) * ifl) >> 8; }   /* 들어올 때 하얗게(미리 곱한 흰색 = a) */
+         if (ia < 256) { r = (r * ia) >> 8; gr = (gr * ia) >> 8; b = (b * ia) >> 8; a = (a * ia) >> 8; }
+         if (!a) continue;
+         uint16_t d = row[px];
+         int dr = (((d >> 11) & 31) * 255 + 15) / 31, dg = (((d >> 5) & 63) * 255 + 31) / 63, db = ((d & 31) * 255 + 15) / 31;
+         int na = 255 - a;
+         dr = r + (dr * na + 127) / 255; dg = gr + (dg * na + 127) / 255; db = b + (db * na + 127) / 255;
+         if (dr > 255) dr = 255;
+         if (dg > 255) dg = 255;
+         if (db > 255) db = 255;
+         row[px] = (uint16_t)(((dr * 31 + 127) / 255) << 11 | ((dg * 63 + 127) / 255) << 5 | ((db * 31 + 127) / 255));
+         if (prow) prow[px] = 0;
+      }
+   }
+}
+
+void ss2hit_draw(uint16_t *buf, int pitch, int ox, int oy, int sub, uint8_t *ph, int half, const uint32_t *cmap)
+{
+   dctx c;
+   if (!buf || !cmap || (sub != 1 && sub != 2 && sub != 4)) return;
+   c.buf = buf; c.pitch = pitch; c.ox = ox; c.oy = oy; c.sub = sub; c.ph = ph; c.cmap = cmap;
+   callout_fx_each(fx_put, &c);                       /* 이펙트(먼저 낸 것부터) — 라벨 밑 */
+   if (callout_enabled()) {
+      callout_t L[2 * CO_ROWS];
+      double now = (h_rf + (half ? 0.5 : 0.0)) / 60.0;
+      int n = callout_get(L, 2 * CO_ROWS, now);
+      if (n > 0 && atlas_ready())
+         for (int i = 0; i < n; i++) {
+            float q[4], al = 0.f, fl = 0.f; int tr[4];
+            if (!callout_layout(&L[i], now, q, tr, &al, &fl) || al <= 0.f) continue;
+            label_draw(&c, (int)lrintf(q[0] * 4.f), (int)lrintf(q[1] * 4.f), tr, (int)(al * 256.f + 0.5f), (int)(fl * 256.f + 0.5f));
+         }
+   }
+}
