+/* 565 섞기 — s 를 a/256 만큼 d 위에 */
+static uint16_t mix565(uint16_t s, uint16_t d, int a)
+{
+   int na = 256 - a;
+   int r = (((s >> 11) & 31) * a + ((d >> 11) & 31) * na + 128) >> 8;
+   int g = (((s >> 5) & 63) * a + ((d >> 5) & 63) * na + 128) >> 8;
+   int b = ((s & 31) * a + (d & 31) * na + 128) >> 8;
+   return (uint16_t)(r << 11 | g << 5 | b);
+}
+
+static void fx_put(void *ctx, int gx, int gy, uint16_t c12, int val, int att)
+{
+   const dctx *c = (const dctx *)ctx;
+   uint16_t v = (uint16_t)c->cmap[c12 & 0xFFF];
+   int a = h_alpha ? h_alpha : FX_A[val & 3];
+   if (c->own && att >= 0) {
+      unsigned o = c->own[gy * 160 + gx], lo = att ? 6u : 1u;
+      if (o >= lo && o <= lo + 4) return;   /* 194 때린 몸(P1 팔레트 0~4 · P2 5~9)이 그린 화소 — 이펙트는 그 밑, 맞은 몸 위 */
+   }
+   for (int ty = 0; ty < c->sub; ty++) {
+      size_t o = (size_t)(c->oy + gy * c->sub + ty) * (size_t)c->pitch + (size_t)(c->ox + gx * c->sub);
+      for (int tx = 0; tx < c->sub; tx++) {
+         c->buf[o + tx] = a >= 256 ? v : mix565(v, c->buf[o + tx], a);
+         if (c->ph) c->ph[o + tx] = 0;   /* 이펙트 화소는 게임 화소 모눈에 맞춰 그렸다 */
+      }
+   }
