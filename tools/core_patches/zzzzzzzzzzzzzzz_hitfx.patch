+static void sl_draw(const dctx *c, int style, int kind, int side, int t, int y)
+{
+   if (t < 0 || t >= SL_T) return;
+   const sl_frame *f = &SL_FRAMES[((style * 4 + kind) * 2 + side) * SL_T + t];
+   for (int k = 0; k < f->n; k++) {
+      const sl_op *op = &SL_OPS[f->first + k];
+      sl_blit(c, op->spr, op->gx, y + op->dy);
+   }
+}
