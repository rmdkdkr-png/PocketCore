+/* 굵기 w 선(끝 둥긂) — 곧은 색 (r, g, b, a) 로 덮기 */
+static void cv_line(double x0, double y0, double x1, double y1, double w, int r, int g, int b, int a, int set)
+{
+   int xa = (int)floor((x0 < x1 ? x0 : x1) - w), xb = (int)ceil((x0 > x1 ? x0 : x1) + w);
+   int ya = (int)floor((y0 < y1 ? y0 : y1) - w), yb = (int)ceil((y0 > y1 ? y0 : y1) + w);
+   double dx = x1 - x0, dy = y1 - y0, ll = dx * dx + dy * dy, h = w / 2.0;
+   for (int y = ya; y <= yb; y++) for (int x = xa; x <= xb; x++) {
+      double px = x + 0.5 - x0, py = y + 0.5 - y0, u = ll > 0 ? (px * dx + py * dy) / ll : 0;
+      if (u < 0) u = 0;
+      if (u > 1) u = 1;
+      double ex = px - u * dx, ey = py - u * dy;
+      if (ex * ex + ey * ey > h * h) continue;
+      if ((unsigned)x >= INK_CW || (unsigned)y >= INK_CH) continue;
+      if (set) { uint8_t *d = ink_cv + ((size_t)y * INK_CW + (size_t)x) * 4; d[0] = (uint8_t)(r * a / 255); d[1] = (uint8_t)(g * a / 255); d[2] = (uint8_t)(b * a / 255); d[3] = (uint8_t)a; }
+      else cv_over(x, y, r * a / 255, g * a / 255, b * a / 255, a);
+   }
+}
+
+/* 글자(그림자 + 흰 글자) — 종류마다 한 번 미리 곱한 RGBA 로 합쳐 둔다(PIL alpha_composite 와 같은 식: 흰 곧은 위 빨강 (210, 24, 24) 를 (4,4) 밀어) */
+static uint8_t *ink_txt[4];
+
+static int ink_text_ready(int kind)
+{
+   if (ink_txt[kind]) return 1;
+   const sli_img *im = &SLI_IMG[kind * 3 + 1];
+   const uint8_t *m = ink_part[kind][1];
+   int tw = im->w + 5, th = im->h + 5;
+   uint8_t *o = (uint8_t *)calloc((size_t)tw * th, 4);
+   if (!o) return 0;
+   for (int v = 0; v < th; v++) for (int u = 0; u < tw; u++) {
+      int wa = (u < im->w && v < im->h) ? m[v * im->w + u] : 0;
+      int sa = (u >= 4 && v >= 4 && u - 4 < im->w && v - 4 < im->h) ? m[(v - 4) * im->w + (u - 4)] : 0;
+      if (!wa && !sa) continue;
+      double A1 = wa / 255.0, A2 = sa / 255.0, A = A1 + A2 * (1 - A1);
+      double R = (255 * A1 + 210 * A2 * (1 - A1)) / A, G = (255 * A1 + 24 * A2 * (1 - A1)) / A, B = (255 * A1 + 24 * A2 * (1 - A1)) / A;
+      int a = (int)(A * 255 + 0.5);
+      uint8_t *d = o + ((size_t)v * tw + u) * 4;
+      d[0] = (uint8_t)(R * a / 255 + 0.5); d[1] = (uint8_t)(G * a / 255 + 0.5); d[2] = (uint8_t)(B * a / 255 + 0.5); d[3] = (uint8_t)a;
+   }
+   ink_txt[kind] = o;
+   return 1;
+}
+
+/* 글자 한 장을 칸 (x0, y0) 에 — fa = 알파 곱(잔상 0.16·0.32·0.48 · 본 글자 1) */
+static void ink_text(int kind, int x0, int y0, double fa)
+{
+   const sli_img *im = &SLI_IMG[kind * 3 + 1];
+   int tw = im->w + 5, th = im->h + 5, k = (int)(fa * 256 + 0.5);
+   if (!ink_text_ready(kind)) return;
+   for (int v = 0; v < th; v++) {
+      const uint8_t *q = ink_txt[kind] + (size_t)v * tw * 4;
+      for (int u = 0; u < tw; u++, q += 4) {
+         if (!q[3]) continue;
+         if (k >= 256) cv_over(x0 + u, y0 + v, q[0], q[1], q[2], q[3]);
+         else { int a = (q[3] * k) >> 8; if (a) cv_over(x0 + u, y0 + v, (q[0] * k) >> 8, (q[1] * k) >> 8, (q[2] * k) >> 8, a); }
+      }
+   }
+}
+
+/* 낙관 — 바탕 그림(52px, −6°)을 s 배 · 시계 반대 방향 da 도 더 돌려(겹선형) 가운데 (cx, cy) 에 — draft_c 는 그때그때 새로 그려 돌린다 */
+static void ink_seal(int kind, double cx, double cy, double s, double da)
+{
+   const sli_img *im = &SLI_IMG[kind * 3 + 2];
+   const uint8_t *q = ink_part[kind][2];
+   double A = da * 3.14159265358979 / 180.0, ca = cos(A), sa = sin(A);
+   int R = (int)(im->w * s * 0.75) + 2;
+   int x0 = (int)(cx - R), y0 = (int)(cy - R);
+   for (int y = 0; y < 2 * R; y++) for (int x = 0; x < 2 * R; x++) {
+      double u = (x0 + x + 0.5 - cx) / s, v = (y0 + y + 0.5 - cy) / s;
+      double fx = u * ca - v * sa + im->w / 2.0 - 0.5, fy = u * sa + v * ca + im->h / 2.0 - 0.5;
+      int ix = (int)floor(fx), iy = (int)floor(fy);
+      double ax = fx - ix, ay = fy - iy, acc[4] = { 0, 0, 0, 0 };
+      for (int k = 0; k < 4; k++) {
+         int sx = ix + (k & 1), sy = iy + (k >> 1);
+         double wk = ((k & 1) ? ax : 1 - ax) * ((k >> 1) ? ay : 1 - ay);
+         if (sx < 0 || sy < 0 || sx >= im->w || sy >= im->h) continue;
+         const uint8_t *p = q + ((size_t)sy * im->w + (size_t)sx) * 4;
+         double pa = p[3] / 255.0;
+         acc[0] += p[0] * pa * wk; acc[1] += p[1] * pa * wk; acc[2] += p[2] * pa * wk; acc[3] += p[3] * wk;
+      }
+      int a = (int)(acc[3] + 0.5);
+      if (a > 0) cv_over(x0 + x, y0 + y, (int)(acc[0] + 0.5), (int)(acc[1] + 0.5), (int)(acc[2] + 0.5), a);   /* acc 0~2 는 이미 미리 곱한 값 */
+   }
+}
+
+/* 칸을 짜 맞춘다(draft_c.render) — 돌려줌: 칸 폭·높이 · 칼선 y. side 0 왼쪽 · 1 오른쪽 */
+static int ink_compose(int kind, int side, double t, int *cw, int *ch, double *cut)
+{
+   const sli_img *bi = &SLI_IMG[kind * 3 + 0], *ti = &SLI_IMG[kind * 3 + 1];
+   const uint8_t *bm = ink_part[kind][0];
+   int bw = bi->w, bh = bi->h, TW = ti->w + 5, TH = ti->h + 5, H = SLI_BAND_H, pad = 10, oy = 15;
+   int CW = bw + 30, CH = bh + 30;
+   if (CW > INK_CW || CH > INK_CH) return 0;
+   memset(ink_cv, 0, sizeof ink_cv);
+   if (t > 47) t = 47;
+   double p = ease_out((t + 1) / 4.0);
+   int xe = (int)(p * (bw + 24));
+   int bx0 = side ? CW - bw : 0;
+   for (int y = 0; y < bh; y++) {
+      double lim = xe - 22.0 * (y + 0.5) / bh;          /* 쓸려 나오는 앞날(기울기 22) */
+      for (int x = 0; x < bw; x++) {
+         if (x + 0.5 > lim) break;
+         int v = bm[y * bw + x];
+         if (!v) continue;
+         int a = (int)(v * 0.92);
+         int X = side ? bx0 + (bw - 1 - x) : x;
+         cv_over(X, y + oy, 16 * a / 255, 12 * a / 255, 12 * a / 255, a);
+      }
+   }
+   if (t < 4) {                                         /* 앞날 빛줄 */
+      static const double YY[3] = { 0.22, 0.5, 0.8 };
+      for (int k = 0; k < 3; k++) {
+         double y = pad + H * YY[k] + oy, xa = xe - 70 - k * 24, xb = xe - 8;
+         if (side) { xa = bx0 + bw - xa; xb = bx0 + bw - xb; }
+         cv_line(xa, y, xb, y - 2, 2, 255, 255, 255, 170, 1);
+      }
+   }
+   if (t >= 2) {                                        /* 글자 미끄러져 들어옴 + 잔상 */
+      double q = ease_out_back((t - 1) / 5.0, 1.5);
+      double tx = pad + 14 - (1 - q) * 150, ty = pad + (H - TH) / 2.0 - 3;
+      if (t < 6)
+         for (int g = 3; g >= 1; g--) {
+            int x = (int)(tx - g * 28);
+            if (side) x = CW - x - TW;
+            ink_text(kind, x, (int)(ty + oy), 0.16 * (4 - g));
+         }
+      int x = (int)tx;
+      if (side) x = CW - x - TW;
+      ink_text(kind, x, (int)(ty + oy), 1.0);
+   }
+   if (t >= 5) {                                        /* 낙관 찍힘 */
+      double s = 1.0 + 0.8 * fmax(0.0, 1 - (t - 5) / 3.0), rot = -16 + 10 * fmin(1.0, (t - 5) / 3.0);
+      double cx = pad + 14 + TW + 14 + SLI_SEAL_PX / 2.0, cy = pad + H / 2.0 - 4 + oy;
+      if (side) cx = CW - cx;
+      ink_seal(kind, cx, cy, s, rot + 6);
+   }
+   *cw = CW; *ch = CH; *cut = oy + pad + H / 2.0 - 4;
+   return 1;
+}
+
+static void ink_draw(const dctx *c, int kind, int side, double t, int y)
+{
+   int cw, ch; double cut;
+   if (t < 0 || t > 58 || !ink_ready(kind) || !ink_compose(kind, side, t, &cw, &ch, &cut)) return;
+   int gx = side ? 160 * 4 - cw : 0, gy = y * 4 - 25;
+   if (t >= 50) {                                       /* 퇴장: 위아래로 갈라져 사라짐 */
+      double v = ease_out((t - 49) / 8.0), fa = fmax(0.0, 1 - v * 1.2);
+      int ia = (int)(fa * 256 + 0.5), ic = (int)cut, dx = (int)(v * 30) * (side ? -1 : 1);
+      int top[4] = { 0, 0, cw, ic }, bot[4] = { 0, ic, cw, ch - ic };
+      if (ia > 0) {
+         pm_draw(c, gx - dx, gy + (int)(-v * 24), ink_cv, INK_CW, top, ia);
+         pm_draw(c, gx + dx, gy + (int)(ic + v * 24), ink_cv, INK_CW, bot, ia);
+      }
+   } else {
+      int all[4] = { 0, 0, cw, ch };
+      pm_draw(c, gx, gy, ink_cv, INK_CW, all, 256);
+   }
+   if (t >= 48 && t <= 51) {                            /* 흰 칼선 — 띠 끝에서 가장자리 쪽으로 */
+      double pr = fmin(1.0, (t - 47) / 3.0);
+      memset(ink_cv, 0, sizeof ink_cv);
+      if (!side) cv_line(cw * (1 - pr), cut + 2, cw, cut - 2, 4, 255, 255, 255, 255, 1);
+      else cv_line(0, cut - 2, cw * pr, cut + 2, 4, 255, 255, 255, 255, 1);
+      int all[4] = { 0, 0, cw, ch };
+      pm_draw(c, gx, gy, ink_cv, INK_CW, all, 256);
+   }
+}
+
+static int label_h(int style, int kind)
+{
+   if (style == 3) return 19;                           /* 먹 띠 — BAND_H + 2 */
+   return kind >= 0 && kind < 4 ? SL_KH[style][kind] : SL_ROWH[style];
+}
+
+void ss2hit_draw(uint16_t *buf, int pitch, int ox, int oy, int sub, uint8_t *ph, int half, const uint32_t *cmap)
+{
+   dctx c;
+   if (!buf || !cmap || (sub != 1 && sub != 2 && sub != 4)) return;
+   c.buf = buf; c.pitch = pitch; c.ox = ox; c.oy = oy; c.sub = sub; c.ph = ph; c.cmap = cmap;
+   c.own = h_under ? ngpgfx_owner_map() : NULL;
+   callout_fx_each(fx_put, &c);                       /* 이펙트(먼저 낸 것부터) — 라벨 밑 */
+   if (callout_enabled()) {
+      callout_t L[2 * CO_ROWS];
+      double now = (h_rf + (half ? 0.5 : 0.0)) / 60.0;
+      int n = callout_get(L, 2 * CO_ROWS, now), st = h_lstyle;
+      for (int i = 0; i < n; i++) {
+         int side = L[i].side ? 1 : 0, y = 34;
+         if (L[i].row > 0) {                            /* 줄 1 — 줄 0 라벨(지났어도) 높이 밑 */
+            callout_t r0;
+            y += (callout_peek(side, 0, &r0) ? label_h(st, r0.kind) : label_h(st, -1)) + 1;
+         }
+         double tf = floor((now - L[i].t0) * 120.0 + 0.5) / 2.0;   /* 반 프레임 단위(120Hz 합성 호출) — 1.9999… 같은 셈 오차로 한 칸 늦지 않게 */
+         if (st == 3) ink_draw(&c, L[i].kind, side, tf, y);
+         else sl_draw(&c, st, L[i].kind, side, (int)floor(tf), y);
+      }
+   }
+}
