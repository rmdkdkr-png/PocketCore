+/* 도트 셋(0·1·2): 1배 그림 하나를 게임 (gx, gy) 에 — PackBits 를 풀며 바로 */
+static void sl_blit(const dctx *c, int spr, int gx, int gy)
+{
+   const sl_sprite *sp = &SL_SPR[spr];
+   const uint32_t *pal = SL_PAL[sp->style];
+   const uint8_t *p = SL_DATA + sp->off;
+   int n = sp->w * sp->h, i = 0;
+   while (i < n) {
+      int b = *p++;
+      if (b < 128) {
+         int v = *p++, cnt = b + 1;
+         for (int k = 0; k < cnt && i < n; k++, i++) if (v) put_rgba(c, gx + i % sp->w, gy + i / sp->w, pal[v]);
+      } else {
+         for (int k = 0; k < b - 127 && i < n; k++, i++) { int v = *p++; if (v) put_rgba(c, gx + i % sp->w, gy + i / sp->w, pal[v]); }
+      }
+   }
+}
